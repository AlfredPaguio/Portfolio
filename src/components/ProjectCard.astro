---
import TechPill from "./TechPill.astro";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { cn } from "@/lib/utils/cn";
import ProjectStatus from "./projects/ProjectStatus.astro";
import type { CollectionEntry } from "astro:content";
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import { normalizeTech } from "@/lib/utils/normalizeTech";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, stack, status, images, featured, date } = project.data;

const cover = images?.[0];

const dateOptions: object = {
  year: "numeric",
  month: "short",
};

const formattedDate = project.data.date
  ? new Date(project.data.date).toLocaleDateString("en-PH", dateOptions)
  : null;

// Limit visible tech to 3 for scannability
const MAX_VISIBLE_TECHS = 3;
const visibleTechs = stack.slice(0, MAX_VISIBLE_TECHS);
const remainingCount = stack.length - MAX_VISIBLE_TECHS;
---

<Card
  class={cn(
    "group relative flex flex-col h-full overflow-hidden transition-all hover:shadow-lg hover:border-primary/30",
    featured && "ring-1 ring-primary/20",
  )}
>
  {
    cover ? (
      <img
        src={cover.src}
        alt={cover.alt || title}
        class="aspect-video object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        loading="lazy"
        width={640}
        height={360}
      />
    ) : (
      <div class="flex aspect-video items-center justify-center bg-muted/40">
        <span class="text-[10px] font-medium text-muted-foreground/60 uppercase tracking-widest">
          Preview
        </span>
      </div>
    )
  }

  <div
    class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    aria-hidden="true"
    style="background: linear-gradient(180deg, transparent 60%, var(--color-primary) / 3%);"
  >
  </div>

  <div class="flex flex-col flex-1">
    <CardHeader class="pb-3">
      <CardTitle class="line-clamp-2">
        <a href={`/projects/${project.id}/`}>{title}</a>
      </CardTitle>

      <CardAction>
        <ProjectStatus status={status} />
      </CardAction>

      {
        formattedDate && (
          <CardDescription class="text-[11px] font-mono mt-1.5">
            {formattedDate}
          </CardDescription>
        )
      }
    </CardHeader>

    <CardContent class="flex-1">
      <p
        class="text-sm text-muted-foreground leading-relaxed line-clamp-3 pb-2"
      >
        {summary}
      </p>
    </CardContent>

    <CardFooter class="pt-4 mt-auto">
      <div class="flex items-center justify-between w-full gap-3">
        {/* Tech pills */}
        <div class="flex flex-wrap gap-1.5 min-h-6">
          {
            visibleTechs.map((techId: string) => {
              const tech = normalizeTech(techId);
              return (
                <TechPill
                  id={tech.id}
                  version={tech.version}
                  class="text-[10px] px-2 py-0.5 bg-muted/40 border-border/40 hover:bg-muted/60 transition-colors"
                />
              );
            })
          }
          {
            remainingCount > 0 && (
              <span class="inline-flex items-center rounded-full border border-border bg-muted/30 text-[10px] px-2 py-0.5 text-muted-foreground">
                +{remainingCount}
              </span>
            )
          }
        </div>

        {/* View indicator */}
        <a href={`/projects/${project.id}/`}>
          <span
            class="text-[10px] text-muted-foreground/60 group-hover:text-primary transition-colors shrink-0 whitespace-nowrap"
          >
            View →
          </span>
        </a>
      </div>
    </CardFooter>
  </div>
</Card>
