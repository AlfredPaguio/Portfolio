---
import { projectBriefs } from "@/data/project-briefs";
import { normalizeTech } from "@/lib/utils/normalizeTech";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ExternalLink from "@lucide/astro/icons/external-link";
import type { CollectionEntry } from "astro:content";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/card/Card.astro";
import TechPill from "./TechPill.astro";

interface Props {
  project: CollectionEntry<"projects">;
  layout?: "standard" | "spotlight" | "compact";
  summaryMode?: "purpose" | "highlight";
  statusStyle?: "badge" | "metadata";
  interactiveTechs?: boolean;
}

const {
  project,
  layout = "standard",
  summaryMode = "purpose",
  statusStyle = "badge",
  interactiveTechs = true,
} = Astro.props;

const { title, summary, stack, images, status, date, links } = project.data;
const brief = projectBriefs[project.id];
// Show the working application rather than its sign-in screen.
const cover =
  project.id === "project-management-app"
    ? images.find((image) => image.src.includes("03-dashboard")) || images[0]
    : images[0];
const href = `/projects/${project.id}/`;
const demo = links.find((link) => link.type === "demo" && !link.disabled);

const statusLabels = {
  active: "Active",
  maintenance: "Maintenance",
  archived: "Archived",
  unknown: "Current status unknown",
} as const;

const statusLabel = statusLabels[status];
const cardSummary =
  summaryMode === "highlight"
    ? brief?.highlight || brief?.purpose || summary
    : brief?.purpose || summary;
    
const visibleStack = stack
  .filter((tech) => !["php", "javascript"].includes(tech.toLowerCase()))
  .slice(0, 3);
const year = date
  ? new Intl.DateTimeFormat("en", { year: "numeric", timeZone: "UTC" }).format(
      date,
    )
  : null;
---

<div class="project-card-container">
<Card
  as="article"
  data-layout={layout}
  class:list={[
    "project-card h-full gap-0 p-0 [&_a:focus-visible]:rounded [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-ring [&_a:focus-visible]:outline-offset-4",
  ]}>
  <a
    href={href}
    class:list={[
      "mx-3 mt-3 flex aspect-video items-center justify-center overflow-hidden rounded-lg bg-background p-3 max-[400px]:p-2",
    ]}
    tabindex="-1"
    aria-hidden="true">
    {
      cover ? (
        <img
          src={cover.src}
          alt=""
          class:list={[
            "block h-full w-full rounded shadow-[0_2px_8px_#00000012]",
            project.id === "project-management-app"
              ? "object-cover object-top"
              : "object-contain",
          ]}
          width={800}
          height={450}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="p-6 text-center text-muted-foreground">{title}</div>
      )
    }
  </a>
  <div
    class:list={[
      "flex min-w-0 flex-1 flex-col items-start p-6 max-[400px]:p-5",
    ]}>
    <div
      class="mb-2.5 flex w-full flex-wrap items-center gap-x-4 gap-y-2 text-xs leading-normal text-muted-foreground">
      <span>{brief?.category || "Software project"}{year && ` / ${year}`}</span>
      {statusLabel && (
        <span
          class:list={[
            statusStyle === "metadata"
              ? "ml-auto text-xs text-muted-foreground"
              : "ml-auto inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-2.5 py-1 text-xs text-muted-foreground",
            status === "active" && statusStyle === "badge" && "text-foreground",
          ]}>
          {status === "active" && statusStyle === "badge" && (
            <span
              aria-hidden="true"
              class="size-1.5 rounded-full bg-[#22863a]"
            />
          )}
          {statusLabel}
        </span>
      )}
    </div>
    <h3
      class:list={[
        "m-0 text-[21px] leading-tight font-[650] tracking-[-0.025em] text-balance wrap-anywhere",
      ]}>
      <a href={href} class="no-underline hover:underline underline-offset-4"
        >{title}</a
      >
    </h3>
    <p
      class:list={[
        "mt-3 mb-4.5 max-w-[60ch] text-sm leading-[1.7] text-muted-foreground",
      ]}>
      {cardSummary}
    </p>
    <div
      class:list={[
        "project-card__techs mb-6 flex flex-wrap gap-1.5 [&_a]:min-h-8 [&_a]:gap-1.5 [&_a]:px-2.25 [&_a]:py-1.25 [&_a:focus-visible]:outline-offset-3",
      ]}
      aria-label="Key technologies"
      role="group">
      {
        visibleStack.map((id) => {
          const tech = normalizeTech(id);
          return (
            <TechPill
              id={tech.id}
              showVersion={false}
              interactive={interactiveTechs}
              class="border-0 bg-muted/60 font-medium"
            />
          );
        })
      }
    </div>
    <div class="mt-auto flex w-full flex-wrap items-center gap-x-5 gap-y-3">
      <Button
        as="a"
        href={href}
        variant={layout === "spotlight" ? "outline" : "ghost"}
        size="lg"
        class="h-auto min-h-11 justify-start px-3 text-[13px] font-semibold no-underline"
        aria-label={`Read project: ${title}`}
        >Read project <ArrowRight class="size-4" aria-hidden="true" /></Button
      >
      {
        demo && (
          <Button
            as="a"
            href={demo.url}
            variant="link"
            size="lg"
            class="h-auto min-h-11 justify-start px-2 text-[13px] text-muted-foreground no-underline"
            target="_blank"
            rel="noopener noreferrer">
            Open live demo{" "}
            <>
              <ExternalLink class="size-3.5" aria-hidden="true" />
              <span class="sr-only"> (opens in a new tab)</span>
            </>
          </Button>
        )
      }
    </div>
  </div>
</Card>
</div>

<style>
  .project-card-container {
    container-type: inline-size;
  }

  @container (min-width: 42rem) {
    :global(.project-card[data-layout="compact"]) {
      display: grid;
      grid-template-columns: 13.75rem minmax(0, 1fr);
    }

    :global(.project-card[data-layout="compact"] > a:first-child) {
      align-self: center;
      aspect-ratio: 16 / 9;
      margin: 0.75rem 0 0.75rem 0.75rem;
      padding: 0.5rem;
    }

    :global(.project-card[data-layout="compact"] > div) {
      padding: 1.25rem 1.5rem;
    }
  }

  @container (min-width: 52rem) {
    :global(.project-card[data-layout="spotlight"]) {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }

    :global(.project-card[data-layout="spotlight"] > a:first-child) {
      aspect-ratio: auto;
      min-height: 18.75rem;
      margin: 1rem 0 1rem 1rem;
      padding: 1rem;
    }

    :global(.project-card[data-layout="spotlight"] > div) {
      padding: 2rem;
    }

    :global(.project-card[data-layout="spotlight"] h3) {
      font-size: 1.75rem;
    }

    :global(.project-card[data-layout="spotlight"] p) {
      font-size: 0.9375rem;
    }
  }

  @media (hover: none) {
    :global(.project-card__techs a) {
      min-height: 2.75rem;
    }
  }
</style>
