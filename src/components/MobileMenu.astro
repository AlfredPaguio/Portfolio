---
import { navItems } from "@/data/nav";

const currentPath = Astro.url.pathname;
---

<div class="md:hidden flex items-center">
  <button
    id="menu-button"
    class="p-2 -mr-2 text-muted-foreground hover:text-foreground transition-colors focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-md"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Toggle navigation menu"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="menu-icon"
    >
      <line
        x1="4"
        x2="20"
        y1="12"
        y2="12"
        class="line-top transition-transform duration-300"></line>
      <line
        x1="4"
        x2="20"
        y1="6"
        y2="6"
        class="line-mid transition-all duration-300"></line>
      <line
        x1="4"
        x2="20"
        y1="18"
        y2="18"
        class="line-bottom transition-transform duration-300"></line>
    </svg>
  </button>

  <div
    id="mobile-menu"
    class="fixed inset-x-6 top-16 z-50 data-[state=close]:hidden opacity-0 translate-y-4 data-[state=open]:flex data-[state=open]:opacity-100 data-[state=open]:translate-y-0 flex-col gap-2 p-2 rounded-2xl border border-border bg-background/95 backdrop-blur-md shadow-2xl transition-all duration-300"
    role="menu"
    aria-labelledby="menu-button"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          role="menuitem"
          class:list={[
            "px-4 py-3 rounded-xl text-sm font-bold transition-colors focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2",
            currentPath === item.href
              ? "bg-primary text-primary-foreground"
              : "hover:bg-muted",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</div>

<script is:inline>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");

  const toggleMenu = () => {
    const isExpanded = button?.getAttribute("aria-expanded") === "true";
    button?.setAttribute("aria-expanded", !isExpanded ? "true" : "false");
    menu?.setAttribute("data-state", !isExpanded ? "open" : "closed");
    menu?.classList.toggle("hidden", isExpanded);
  };

  button?.addEventListener("click", (e) => {
    e.stopPropagation();
    toggleMenu();
  });

  // Close when clicking outside
  document.addEventListener("click", (e) => {
    if (
      button?.getAttribute("aria-expanded") === "true" &&
      !menu?.contains(e.target)
    ) {
      toggleMenu();
    }
  });
  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      button?.getAttribute("aria-expanded") === "true"
    ) {
      toggleMenu();
      button.focus();
    }
  });
</script>
