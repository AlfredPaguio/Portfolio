---
import { cn } from "@/lib/utils/cn";

const { href, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  class={cn(
    "rounded-sm text-primary underline underline-offset-4 wrap-anywhere hover:decoration-2 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-4",
    className,
  )}
  {...rest}>
  <slot />
</a>
