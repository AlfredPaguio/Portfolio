---
const links = [
  { label: "Privacy", href: "/privacy" },
  { label: "Now", href: "/now" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<nav class="flex items-center gap-4" aria-label="Footer navigation">
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-current={currentPath === link.href ? "page" : undefined}
        class="inline-flex min-h-11 items-center rounded-md text-sm text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring touch-manipulation"
      >
        {link.label}
      </a>
    ))
  }
</nav>
