---
import { navItems } from "@/data/nav";

const links = [...navItems, { label: "Privacy", href: "/privacy" }];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(`${href}/`));
---

<nav class="flex flex-col items-start gap-0.5" aria-label="Footer navigation">
  {links.map((link) => (
    <a
      href={link.href}
      aria-current={isActive(link.href) ? "page" : undefined}
      class="inline-flex min-h-11 items-center rounded-md px-1 -ml-1 text-sm text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring touch-manipulation">
      {link.label}
    </a>
  ))}
</nav>
