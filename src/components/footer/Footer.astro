---
import AnchorExternalLink from "@/components/AnchorExternalLink.astro";
import Brand from "@/components/Brand.astro";
import TechPill from "@/components/TechPill.astro";
import Separator from "@/components/ui/Separator.astro";
import { frontmatter as resumeData } from "@/content/resumes.md";
import { siteConfig } from "@/data/site";
import Code from "@lucide/astro/icons/code";
import FileText from "@lucide/astro/icons/file-text";
import Mail from "@lucide/astro/icons/mail";
import BackToTop from "./BackToTop.astro";
import FooterNav from "./FooterNav.astro";

const year = new Date().getFullYear();
---

<footer class="w-full" data-site-footer>
  <div class="mx-auto max-w-5xl px-6">
    <div class="border-t border-border pt-10 pb-8" data-footer-body>
      <div class="grid gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
        <div class="space-y-4">
          <a
            href="/"
            class="group/brand inline-flex min-h-11 items-center gap-2.5 rounded-lg text-foreground transition-colors hover:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
            <span
              aria-hidden="true"
              class="transition-transform duration-200 ease-out group-hover/brand:-rotate-6 motion-reduce:transform-none motion-reduce:transition-none">
              <Brand class="size-7" />
            </span>
            <span class="text-sm font-semibold tracking-tight">
              Alfred U. Paguio
            </span>
          </a>

          <p class="max-w-[42ch] text-sm leading-relaxed text-muted-foreground">
            Junior Software Developer based in the Philippines (UTC+8). Building
            practical web applications with Laravel and React.
          </p>

          {resumeData.availability && (
            <p class="inline-flex items-center gap-2 text-xs text-muted-foreground">
              <span
                class="size-1.5 rounded-full bg-status-active"
                aria-hidden="true"
              />
              {resumeData.availability}
            </p>
          )}
        </div>

        <div class="grid grid-cols-2 gap-8">
          <div>
            <h2 class="mb-2 font-mono text-[11px] font-medium tracking-wider text-muted-foreground uppercase">
              Navigate
            </h2>
            <FooterNav />
          </div>

          <div>
            <h2 class="mb-2 font-mono text-[11px] font-medium tracking-wider text-muted-foreground uppercase">
              Connect
            </h2>
            <ul class="flex flex-col items-start gap-0.5">
              <li>
                <a
                  href={`/resumes/${resumeData.currently_using}`}
                  class="inline-flex min-h-11 items-center gap-2 rounded-md px-1 -ml-1 text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                  <FileText class="size-3.5" aria-hidden="true" />
                  Resume (PDF)
                </a>
              </li>
              <li>
                <a
                  href={`mailto:${siteConfig.email}`}
                  class="inline-flex min-h-11 items-center gap-2 rounded-md px-1 -ml-1 text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                  <Mail class="size-3.5" aria-hidden="true" />
                  Email
                </a>
              </li>
              <li>
                <AnchorExternalLink
                  href={siteConfig.links.socials.github}
                  class="min-h-11 px-1 -ml-1 text-sm text-muted-foreground no-underline hover:text-foreground">
                  GitHub
                </AnchorExternalLink>
              </li>
              <li>
                <AnchorExternalLink
                  href={siteConfig.links.socials.linkedin}
                  class="min-h-11 px-1 -ml-1 text-sm text-muted-foreground no-underline hover:text-foreground">
                  LinkedIn
                </AnchorExternalLink>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <Separator class="my-6" />

      <div class="flex flex-col items-start justify-between gap-4 text-xs text-muted-foreground sm:flex-row sm:items-center">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <p>© {year} Alfred U. Paguio</p>
          <a
            href={siteConfig.links.repository}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-1.5 rounded-md transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
            <Code class="size-3.5" aria-hidden="true" />
            Source<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a
            href="/llms-full.txt"
            class="inline-flex min-h-11 items-center rounded-md transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
            llms-full.txt
          </a>
          <a
            href="/rss.xml"
            class="inline-flex min-h-11 items-center rounded-md transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
            RSS
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span>Built with</span>
          <div class="inline-flex items-center gap-1.5">
            <TechPill
              id="astro"
              showVersion={false}
              class="border-border/70 bg-muted/40 text-xs font-medium"
            />
            <TechPill
              id="tailwindcss"
              showVersion={false}
              class="border-border/70 bg-muted/40 text-xs font-medium"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
<BackToTop />

<script>
  import { animate, inView } from "motion";

  const footer = document.querySelector<HTMLElement>("[data-footer-body]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (
    footer &&
    !reducedMotion.matches &&
    footer.getBoundingClientRect().top > window.innerHeight
  ) {
    footer.style.opacity = "0";
    inView(
      footer,
      () => {
        animate(
          footer,
          { opacity: [0, 1], y: [12, 0] },
          { duration: 0.35, ease: [0.22, 1, 0.36, 1] },
        );
      },
      { amount: 0.1 },
    );
  }
</script>
