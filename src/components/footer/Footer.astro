---
import { siteConfig } from "@/data/site";
import Code from "@lucide/astro/icons/code";
import TechPill from "../TechPill.astro";
import FooterNav from "./FooterNav.astro";
import BackToTop from "./BackToTop.astro";
const year = new Date().getFullYear();
---

<footer class="w-full">
  <div class="max-w-5xl mx-auto px-6">
    <div class="border-t border-border pt-5 pb-4 sm:pt-6 sm:pb-6">
      <div
        class="flex flex-col items-center gap-1 sm:flex-row sm:justify-between sm:gap-6"
      >
        <p class="text-sm text-muted-foreground">© {year} Alfred U. Paguio</p>
        <div
          class="flex flex-wrap justify-center items-center gap-x-4 gap-y-1 sm:justify-start"
        >
          <a
            href={siteConfig.links.repository}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 rounded-md text-sm text-muted-foreground hover:text-foreground transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring touch-manipulation"
          >
            <Code class="size-4" aria-hidden="true" />
            Source<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <FooterNav />
        </div>
      </div>
      <div
        class="mt-1 flex flex-wrap justify-center items-center gap-x-2 text-xs text-muted-foreground sm:justify-start [&_a]:min-h-11 [&_a]:min-w-11 [&_a]:justify-center [&_a]:px-2 [&_a]:rounded-md [&_a]:hover:bg-muted [&_a]:focus-visible:outline-2 [&_a]:focus-visible:outline-offset-2 [&_a]:focus-visible:outline-ring [&_a>span:last-child]:hidden sm:[&_a>span:last-child]:inline"
      >
        <span>Built with</span>
        <div class="inline-flex items-center gap-1 whitespace-nowrap">
          <TechPill
            id="astro"
            showVersion={false}
            class="border-none bg-transparent px-0 text-xs font-normal"
          />
          <TechPill
            id="tailwindcss"
            showVersion={false}
            class="border-none bg-transparent px-0 text-xs font-normal"
          />
        </div>
      </div>
    </div>
  </div>
</footer>
<BackToTop />
