---
import Moon from "@lucide/astro/icons/moon";
import Sun from "@lucide/astro/icons/sun";
import Button from "./ui/Button.astro";
---

<Button
  variant="ghost"
  size="icon-lg"
  id="themeToggle"
  aria-label="Toggle theme"
  class="cursor-pointer relative size-11 touch-manipulation transition-colors">
  <Sun
    aria-hidden="true"
    class="size-5 duration-300 rotate-0 scale-100 transition-transform motion-reduce:transition-none dark:-rotate-90 dark:scale-0 ease-in-out"
  />
  <Moon
    aria-hidden="true"
    class="size-5 absolute duration-300 rotate-90 scale-0 transition-transform motion-reduce:transition-none dark:rotate-0 dark:scale-100 ease-in-out"
  />
</Button>

<script is:inline>
  const theme = (() => {
    let localStorageTheme = "";
    try {
      localStorageTheme = localStorage.getItem("theme") ?? "";
    } catch {}
    if (["dark", "light"].includes(localStorageTheme)) {
      return localStorageTheme;
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  })();

  const root = document.documentElement;
  const updateThemeColor = () => {
    // const resolvedColor = getComputedStyle(root)
    // .getPropertyValue("--color-background")
    // .trim();
    // console.log(resolvedColor)
    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      "content",
      root.classList.contains("dark") ? "#060606" : "#f2f2f2",
      // resolvedColor,
    );
  };

  if (theme === "light") {
    root.classList.remove("dark");
  } else {
    root.classList.add("dark");
  }

  try {
    localStorage.setItem("theme", theme);
  } catch {}
  updateThemeColor();

  const handleToggleClick = () => {
    const isDark = root.classList.toggle("dark");
    updateThemeColor();

    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {}
  };

  document
    .getElementById("themeToggle")
    ?.addEventListener("click", handleToggleClick);
</script>
