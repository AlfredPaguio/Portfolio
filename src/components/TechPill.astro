---
import { normalizeId } from "@/lib/utils/normalizeId";
import { getCollection, render } from "astro:content";
interface Props {
  id: string;
}
const { id } = Astro.props;
const techs = await getCollection("techs");

const tech = techs.find((t) => normalizeId(id).includes(normalizeId(t.id)));

const hasEntry = !!tech;
let Content: any;
if (hasEntry) {
  const rendered = await render(tech);
  Content = rendered.Content;
}
---

<div
  class="inline-flex items-center px-3 py-1 rounded-full border border-border bg-muted/30 text-foreground text-xs font-bold select-none"
>
  {
    hasEntry ? (
      <a
        href={tech.data.href}
        target="_blank"
        class="inline-flex items-center gap-2 no-underline"
      >
        {tech?.data.hasIcon && Content && (
          <span class="size-3.5 flex items-center justify-center [&>svg]:size-full">
            <Content />
          </span>
        )}
        <span class="text-xs font-bold leading-none">
          {tech.data.name}{" "}
          {tech.data.version && (
            <span class="ml-1 font-normal opacity-60 text-[10px]">
              {tech.data.version}
            </span>
          )}
        </span>
      </a>
    ) : (
      // Fallback
      <div class="inline-flex items-center gap-2 no-underline">
        <span class="text-xs font-bold leading-none">
          {id.replace(/-/g, " ")}
        </span>
      </div>
    )
  }
</div>
