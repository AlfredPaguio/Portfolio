---
import { cn } from "@/lib/utils/cn";
import { normalizeId } from "@/lib/utils/normalizeId";
import toTitleCase from "@/lib/utils/toTitleCase";
import { getCollection, render } from "astro:content";
interface Props {
  class?: string;
  id: string;
  version?: string | number;
  showVersion?: boolean;
}
const {
  id,
  class: className,
  version: versionOverride,
  showVersion = true,
} = Astro.props;
const techs = await getCollection("techs");

const tech =
  techs.find((t) => t.id === id || normalizeId(id) === normalizeId(t.id)) ??
  techs.find((t) => normalizeId(id).includes(normalizeId(t.id)));

//or normalizeId(t.id) === normalizeId(id) needs more investigation

const hasEntry = !!tech;
const Tag = tech?.data.href ? "a" : "span";
let Content: any;
if (hasEntry) {
  const rendered = await render(tech);
  Content = rendered.Content;
}

// Determine which version to display (Prop takes priority)
const displayVersion = showVersion
  ? (versionOverride ?? tech?.data.version)
  : undefined;
---

<div
  class={cn(
    "inline-flex items-center rounded-full border border-border bg-muted/30 text-foreground text-xs font-bold select-none transition-colors",
    tech?.data.href && "hover:border-foreground/20",
    className,
  )}>
  {
    hasEntry ? (
      <Tag
        href={tech.data.href}
        target={tech.data.href ? "_blank" : undefined}
        rel={tech.data.href ? "noopener noreferrer" : undefined}
        class:list={[
          "inline-flex min-h-7 items-center gap-2 rounded-full px-3 py-1 no-underline",
          tech.data.href &&
            "hover:text-primary focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-3",
        ]}
        aria-label={
          tech.data.href
            ? `Open ${tech.data.name} website/documentation`
            : undefined
        }>
        {tech?.data.hasIcon && Content && (
          <span
            class="size-3.5 flex items-center justify-center [&>svg]:size-full"
            aria-hidden="true">
            <Content iconId={`tech-${crypto.randomUUID()}`} />
          </span>
        )}
        <span>
          {tech.data.name}
          {displayVersion && (
            <span class="ml-1 font-normal opacity-60 text-[10px]">
              {displayVersion}
            </span>
          )}
        </span>
      </Tag>
    ) : (
      // Fallback
      <div class="inline-flex items-center gap-2 no-underline px-3 py-1">
        <span class="text-xs font-bold leading-none">
          {/* {id.replace(/-/g, " ")} */}
          {toTitleCase(id)}
          {versionOverride && (
            <span class="ml-1 font-normal opacity-60 text-[10px]">
              {versionOverride}
            </span>
          )}
        </span>
      </div>
    )
  }
</div>
