---
import { cn } from "@/lib/utils/cn";
import { normalizeId } from "@/lib/utils/normalizeId";
import { getCollection, render } from "astro:content";
interface Props {
  class?: string;
  id: string;
}
const { id, class: className } = Astro.props;
const techs = await getCollection("techs");

const tech = techs.find(
  (t) => t.id === id || normalizeId(id).includes(normalizeId(t.id)),
);

//or normalizeId(t.id) === normalizeId(id) needs more investigation

const hasEntry = !!tech;
let Content: any;
if (hasEntry) {
  const rendered = await render(tech);
  Content = rendered.Content;
}
---

<div
  class={cn(
    "inline-flex items-center rounded-full border border-border bg-muted/30 text-foreground text-xs font-bold select-none transition-colors",
    hasEntry && "hover:border-foreground/20",
    className,
  )}
>
  {
    hasEntry ? (
      <a
        href={tech.data.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3 py-1 no-underline hover:text-primary"
        aria-label={`Open ${tech.data.name} website/documentation`}
      >
        {tech?.data.hasIcon && Content && (
          <span
            class="size-3.5 flex items-center justify-center [&>svg]:size-full"
            aria-hidden="true"
          >
            <Content />
          </span>
        )}
        <span>
          {tech.data.name}
          {tech.data.version && (
            <span class="ml-1 font-normal opacity-60 text-[10px]">
              {tech.data.version}
            </span>
          )}
        </span>
      </a>
    ) : (
      // Fallback
      <div class="inline-flex items-center gap-2 no-underline px-3 py-1">
        <span class="text-xs font-bold leading-none">
          {id.replace(/-/g, " ")}
        </span>
      </div>
    )
  }
</div>
