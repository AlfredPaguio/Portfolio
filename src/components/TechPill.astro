---
import { getEntry, render } from "astro:content";
interface Props {
  id: string;
}
const { id } = Astro.props;
const tech = await getEntry("techs", id);
const hasEntry = !!tech;
let Content: any;
if (hasEntry) {
  const rendered = await render(tech);
  Content = rendered.Content;
}
---

<div
  class="inline-flex items-center px-3 py-1 rounded-full border border-border bg-muted/30 text-foreground text-xs font-bold select-none"
>
  {
    hasEntry ? (
      <a
        href={tech.data.href}
        target="_blank"
        class="inline-flex items-center gap-2"
      >
        <span class="size-3.5 flex items-center justify-center [&>svg]:size-full">
          <Content />
        </span>
        <span class="text-xs font-bold leading-none">
          {tech.data.name}{" "}
          {tech.data.version && (
            <span class="ml-1 font-normal opacity-60 text-[10px]">
              {tech.data.version}
            </span>
          )}
        </span>
      </a>
    ) : (
      // Fallback
      <span class="capitalize">{id.replace(/-/g, " ")}</span>
    )
  }
</div>
