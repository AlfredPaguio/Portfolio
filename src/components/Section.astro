---
import { cn } from "@/lib/utils/cn";

interface Props {
  title?: string;
  id?: string;
  class?: string;
}
const { title, id, class: className } = Astro.props;
---

<section
  id={id}
  aria-labelledby={id ? `${id}-heading` : undefined}
  class={cn("py-8", className)}
>
  {
    title && (
      <h2
        id={`${id}-heading`}
        class="text-sm font-bold uppercase tracking-widest text-neutral-500 mb-8"
      >
        {title}
      </h2>
    )
  }
  <slot />
</section>
