---
import TechPill from "./TechPill.astro";

const year = new Date().getFullYear();
const repoLink = "https://github.com/AlfredPaguio/portfolio";
---

<footer class="w-full border-t border-border mt-20">
  <div class="max-w-3xl mx-auto px-6 py-12">
    <div
      class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8"
    >
      <div class="space-y-4">
        <div>
          <p class="text-sm font-bold tracking-tight">
            © {year} Alfred U. Paguio
          </p>
          <p class="text-xs text-muted-foreground mt-1">
            Lorem ipsum dolor, sit amet consectetur adipisicing.
          </p>
        </div>

        <a
          href={repoLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-mono text-muted-foreground hover:text-foreground transition-colors group"
        >
          <span>Repository</span>
          <span
            class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            >↗</span
          >
        </a>
      </div>

      <div class="flex flex-col items-start md:items-end gap-4">
        <div
          class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-muted-foreground"
        >
          <span>Built with: </span>
          <div
            class="flex items-center gap-1 bg-muted/50 p-1 rounded-lg border border-border"
          >
            <TechPill
              id="astro"
              class="scale-90 border-none bg-transparent px-1"
            />
            <span class="opacity-20">and</span>
            <TechPill
              id="tailwindcss"
              class="scale-90 border-none bg-transparent px-1"
            />
          </div>
        </div>

        <nav
          class="flex gap-4 text-[10px] font-bold uppercase tracking-widest text-muted-foreground/60"
        >
          <a href="/privacy" class="hover:text-foreground transition-colors"
            >Privacy</a
          >
          <a href="/now" class="hover:text-foreground transition-colors"
            >Status</a
          >
          <a href="#main" class="hover:text-foreground transition-colors"
            >Top &uarr;</a
          >
        </nav>
      </div>
    </div>
  </div>
</footer>
