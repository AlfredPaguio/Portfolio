---
import { termGlossary, type TermDefinition } from "@/data/term-glossary";

interface Props {
  id?: string;
  term: keyof typeof termGlossary;
}

const { id, term } = Astro.props;
const entry: TermDefinition = termGlossary[term];
const { label, definition, href, linkLabel = "Read the reference" } = entry;
const definitionId = id ?? `term-hint-${crypto.randomUUID()}`;
---

<span class="group relative inline" data-term-hint>
  <button
    class="relative inline cursor-help rounded-[0.1rem] border-0 bg-transparent p-0 font-[inherit] text-inherit underline decoration-dotted underline-offset-[0.2em] after:absolute after:-inset-x-1 after:-inset-y-2.5 after:content-[''] hover:decoration-solid focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-[3px]"
    type="button"
    aria-label={`Explain ${label}`}
    aria-expanded="false"
    aria-describedby={definitionId}
    aria-controls={definitionId}
    data-term-trigger><slot>{label}</slot></button
  >
  <span
    class="invisible absolute left-0 top-[calc(100%+0.55rem)] z-50 grid w-[min(20rem,calc(100vw-2rem))] -translate-y-1 gap-2.5 rounded-xl border border-border bg-popover px-4 py-3 text-left text-sm leading-6 text-popover-foreground opacity-0 shadow-lg transition-[opacity,transform,visibility] duration-150 ease-out group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-data-[open=true]:visible group-data-[open=true]:translate-y-0 group-data-[open=true]:opacity-100 max-[42rem]:fixed max-[42rem]:inset-x-4 max-[42rem]:top-auto max-[42rem]:bottom-4 max-[42rem]:left-auto max-[42rem]:right-auto max-[42rem]:mx-auto max-[42rem]:w-auto max-[42rem]:max-w-104 max-[42rem]:shadow-xl pointer-coarse:fixed pointer-coarse:inset-x-4 pointer-coarse:top-auto pointer-coarse:bottom-4 pointer-coarse:left-auto pointer-coarse:right-auto pointer-coarse:mx-auto pointer-coarse:w-auto pointer-coarse:max-w-104 pointer-coarse:shadow-xl motion-reduce:transition-none"
    id={definitionId}
    role="group"
    aria-label={`${label} details`}>
    <span>{definition}</span>
    {
      href && (
        <a
          class="w-fit font-semibold text-foreground underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2"
          href={href}
          target="_blank"
          rel="noreferrer">
          {linkLabel}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      )
    }
  </span>
</span>

<script>
  const closeTermHints = (except?: HTMLElement) => {
    document
      .querySelectorAll<HTMLElement>("[data-term-hint][data-open='true']")
      .forEach((hint) => {
        if (hint !== except) {
          hint.dataset.open = "false";
          hint
            .querySelector<HTMLButtonElement>("[data-term-trigger]")
            ?.setAttribute("aria-expanded", "false");
        }
      });
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const trigger = target.closest<HTMLButtonElement>("[data-term-trigger]");
    if (trigger) {
      const hint = trigger.closest<HTMLElement>("[data-term-hint]");
      if (!hint) return;
      const willOpen = hint.dataset.open !== "true";
      closeTermHints(hint);
      hint.dataset.open = String(willOpen);
      trigger.setAttribute("aria-expanded", String(willOpen));
      return;
    }
    if (!target.closest("[data-term-hint]")) closeTermHints();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const openHint = document.querySelector<HTMLElement>(
      "[data-term-hint][data-open='true']",
    );
    if (!openHint) return;
    closeTermHints();
    openHint.querySelector<HTMLButtonElement>("[data-term-trigger]")?.focus();
  });
</script>
