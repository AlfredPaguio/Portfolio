---
import MobileMenu from "./MobileMenu.astro";
import Navigation from "./Navigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
---

<header
  class="fixed top-6 inset-x-0 z-50 flex justify-center px-6 pointer-events-none"
>
  <div
    class="flex items-center justify-between w-full max-w-5xl h-12 px-4 rounded-full border border-border backdrop-blur-md shadow-sm pointer-events-auto"
  >
    <a
      href="/"
      class="text-sm font-bold tracking-tight hover:opacity-70 transition-opacity focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-md"
    >
      Portfolio
    </a>
    <div class="flex items-center gap-2">
      <div class="hidden md:block">
        <Navigation />
      </div>

      <div class="hidden md:block w-px h-4 bg-border mx-1"></div>
      <ThemeIcon />
      
      <MobileMenu />
    </div>
  </div>
</header>
