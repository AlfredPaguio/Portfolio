---
interface Props {
  src: string;
  title?: string;
}
const { src, title = "Project Demo" } = Astro.props;

// Convert standard YouTube links to embed links if necessary
const getEmbedUrl = (url: string) => {
  if (url.includes("youtube.com/watch?v=")) {
    return url.replace("watch?v=", "embed/");
  }
  return url;
};
---

<div
  class="relative aspect-video w-full pb-[56.25%] mb-[50px] rounded-xl overflow-hidden border border-border bg-black h-0"
>
  <iframe
    src={getEmbedUrl(src)}
    width="100%"
    height="100%"
    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
    title={title}
    class="h-full w-full absolute top-0 left-0"></iframe>
</div>
