---
import { videoSource } from "@/lib/media-source";
interface Props {
  src: string;
  title?: string;
}
const { src, title = "Project demo" } = Astro.props;
const source = videoSource(src);
---

<div
  class="my-6 aspect-video w-full overflow-hidden rounded-xl border border-border bg-muted"
>
  {
    source?.native ? (
      <video
        src={source.src}
        controls
        playsinline
        preload="metadata"
        aria-label={title}
        class="size-full object-contain"
      />
    ) : source ? (
      <iframe
        src={source.src}
        title={title}
        loading="lazy"
        allow="encrypted-media; picture-in-picture; fullscreen"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        class="size-full border-0"
      />
    ) : (
      <p class="p-4 text-sm text-muted-foreground">
        Video preview unavailable.
      </p>
    )
  }
</div>
