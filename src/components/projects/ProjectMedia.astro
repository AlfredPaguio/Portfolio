---
import type { MediaItem } from "@/lib/gallery-manager";
import { safeMediaUrl } from "@/lib/media-source";
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import ExternalLink from "@lucide/astro/icons/external-link";
import Maximize from "@lucide/astro/icons/maximize";
import Minus from "@lucide/astro/icons/minus";
import Play from "@lucide/astro/icons/play";
import Plus from "@lucide/astro/icons/plus";
import X from "@lucide/astro/icons/x";
interface Props {
  images?: { src: string; alt?: string }[];
  videos?: string[];
}
const { images = [], videos = [] } = Astro.props;
const media: MediaItem[] = [
  ...videos
    .filter((src) => src.trim() && safeMediaUrl(src))
    .map((src, i) => ({
      type: "video" as const,
      src,
      alt: videos.length > 1 ? `Video demo ${i + 1}` : "Video demo",
    })),
  ...images
    .filter((image) => image.src.trim() && safeMediaUrl(image.src))
    .map((image, i) => ({
      type: "image" as const,
      src: image.src,
      alt: image.alt?.trim() || `Project screenshot ${i + 1}`,
    })),
];
const focus =
  "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring";
const control =
  "inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-neutral-200 hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent cursor-pointer touch-manipulation";
---

{
  media.length > 0 && (
    <project-gallery
      data-gallery={JSON.stringify(media)}
      class="mt-5 block w-full">
      <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2 text-sm text-muted-foreground">
        <p>Select a preview to explore the details.</p>
        <span class="tabular-nums">
          {media.length} {media.length === 1 ? "preview" : "previews"}
        </span>
      </div>
      <div class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        {media.map((item, index) => (
          <a
            href={item.src}
            data-open={index}
            aria-haspopup="dialog"
            class:list={[
              "group block min-w-0 rounded-xl",
              focus,
              index === 0 && "sm:col-span-2",
            ]}>
            {item.type === "image" && <span class="sr-only">Enlarge </span>}
            <div
              class:list={[
                "relative flex items-center justify-center overflow-hidden rounded-xl border border-border bg-muted/50 transition-colors group-hover:border-foreground/40 motion-reduce:transition-none",
                index === 0 ? "aspect-video p-3 sm:p-5" : "aspect-16/10 p-2.5",
              ]}>
              {item.type === "image" ? (
                <img
                  src={item.src}
                  alt=""
                  width={960}
                  height={600}
                  loading="lazy"
                  decoding="async"
                  class="size-full rounded-sm object-cover object-top"
                />
              ) : (
                <div class="flex flex-col items-center gap-3 py-6">
                  <span class="flex size-16 items-center justify-center rounded-full border border-border bg-card text-foreground transition-transform group-hover:scale-105 motion-reduce:transform-none">
                    <Play class="ml-1 size-6" aria-hidden="true" />
                  </span>
                  <span class="text-sm font-medium">
                    Watch the project in action
                  </span>
                  <span class="text-xs text-muted-foreground">Video demo</span>
                </div>
              )}
              <span class="absolute right-3 bottom-3 flex size-9 items-center justify-center rounded-lg border border-border bg-card/95 text-foreground shadow-sm">
                <Maximize class="size-4" aria-hidden="true" />
              </span>
            </div>
            <div class="mt-2.5 flex items-start justify-between gap-3 px-0.5">
              <span class="min-w-0 text-sm leading-6 font-medium wrap-break-word">
                {item.alt}
              </span>
              <span class="shrink-0 text-xs leading-6 text-muted-foreground tabular-nums">
                {index + 1} / {media.length}
              </span>
            </div>
          </a>
        ))}
      </div>
      <dialog
        aria-label="Project media viewer"
        class="fixed inset-0 m-auto h-dvh max-h-dvh w-screen max-w-none overflow-hidden overscroll-contain border-0 bg-neutral-950 p-0 text-neutral-100 backdrop:bg-black/80 backdrop:backdrop-blur-sm lg:h-[calc(100dvh-3rem)] lg:max-h-240 lg:w-[calc(100vw-3rem)] lg:max-w-400 lg:rounded-2xl lg:border lg:border-white/15">
        <div class="flex h-full min-h-0 flex-col pt-[env(safe-area-inset-top)] pr-[env(safe-area-inset-right)] pb-[env(safe-area-inset-bottom)] pl-[env(safe-area-inset-left)]">
          <header class="flex shrink-0 items-center justify-between gap-4 border-b border-white/10 px-4 py-2 sm:px-6 sm:py-3">
            <div
              class="flex min-w-0 flex-col gap-0.5"
              aria-live="polite"
              aria-atomic="true">
              <span
                data-counter
                class="text-xs text-neutral-400 tabular-nums"
              />
              <strong
                data-title
                class="truncate text-sm font-medium sm:text-base"
              />
            </div>
            <button
              type="button"
              data-close
              class={control}
              aria-label="Close media viewer"
              autofocus>
              <X class="size-5" aria-hidden="true" />
            </button>
          </header>
          <div
            data-viewport
            class="relative flex min-h-0 flex-1 items-center justify-center overflow-hidden overscroll-contain bg-black/30 p-3 sm:p-6"
          />
          <div class="flex shrink-0 flex-wrap items-center justify-between gap-x-3 gap-y-1 border-t border-white/10 px-3 py-1.5 sm:px-6">
            <div class="flex items-center gap-1">
              <button
                type="button"
                data-prev
                class={control}
                aria-label="Previous media">
                <ChevronLeft class="size-5" aria-hidden="true" />
              </button>
              <button
                type="button"
                data-next
                class={control}
                aria-label="Next media">
                <ChevronRight class="size-5" aria-hidden="true" />
              </button>
            </div>
            <div
              data-zoom
              class="flex items-center rounded-lg border border-white/15">
              <button
                type="button"
                data-zoom-out
                class={control}
                aria-label="Zoom out">
                <Minus class="size-4" aria-hidden="true" />
              </button>
              <button
                type="button"
                data-reset
                class="inline-flex h-11 min-w-14 cursor-pointer items-center justify-center px-1 text-xs text-neutral-300 tabular-nums hover:text-white focus-visible:outline-2 focus-visible:outline-white"
                aria-label="Reset image zoom (100%)">
                100%
              </button>
              <button
                type="button"
                data-zoom-in
                class={control}
                aria-label="Zoom in">
                <Plus class="size-4" aria-hidden="true" />
              </button>
            </div>
            <a
              data-original
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 rounded px-1 text-xs text-neutral-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
              <>
                <span>Open original</span>
                <ExternalLink class="size-3.5" aria-hidden="true" />
                <span class="sr-only"> (opens in a new tab)</span>
              </>
            </a>
          </div>
          {media.length > 1 && (
            <nav
              aria-label="Choose project media"
              class="flex shrink-0 gap-2 overflow-x-auto overscroll-x-contain border-t border-white/10 px-4 py-3 sm:justify-start sm:px-6">
              {media.map((item, index) => (
                <button
                  type="button"
                  data-select={index}
                  aria-label={`View ${item.alt}`}
                  aria-current="false"
                  class="relative flex h-14 w-20 shrink-0 cursor-pointer items-center justify-center overflow-hidden rounded-md border border-white/15 bg-white/5 p-1 opacity-50 hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white aria-current:border-white aria-current:opacity-100">
                  {item.type === "image" ? (
                    <img
                      src={item.src}
                      alt=""
                      loading="lazy"
                      width={80}
                      height={56}
                      class="size-full object-contain"
                    />
                  ) : (
                    <Play class="size-5" aria-hidden="true" />
                  )}
                </button>
              ))}
            </nav>
          )}
          <p class="hidden shrink-0 px-4 pb-3 text-center text-xs text-neutral-400 sm:block">
            Arrow keys to browse · Pinch or use + / - to zoom · Esc to close
          </p>
        </div>
      </dialog>
    </project-gallery>
  )
}
<script>
  import "@/lib/gallery-element";
</script>
