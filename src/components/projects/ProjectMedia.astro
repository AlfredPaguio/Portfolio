---
import Play from "@lucide/astro/icons/play";
import Maximize from "@lucide/astro/icons/maximize";
import X from "@lucide/astro/icons/x";
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Download from "@lucide/astro/icons/download";
import ProjectVideo from "./ProjectVideo.astro";

interface Props {
  images?: { src: string; alt?: string }[];
  videos?: string[];
}

const { images = [], videos = [] } = Astro.props;

const allMedia = [
  ...videos.map((v) => ({ type: "video", src: v, alt: "Video Demo" })),
  ...images.map((i) => ({
    type: "image",
    src: i.src,
    alt: i.alt || "Project Image",
  })),
];

const mediaSerialized = JSON.stringify(allMedia);

const padIndex = (i: number) => String(i + 1).padStart(2, "0");
---

<div class="my-12 w-full space-y-6 select-none">
  <div
    class="flex items-center justify-between border-b border-border pb-2 px-1"
  >
    <span
      class="text-sm font-bold uppercase tracking-widest text-muted-foreground/80"
      >Project Media</span
    >
    <span class="text-[10px] font-mono text-muted-foreground/40"
      >{allMedia.length} ASSETS</span
    >
  </div>

  <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-4">
    {
      allMedia.map((item, index) => (
        <button
          class="media-trigger group relative aspect-video overflow-hidden rounded-xl border border-border bg-card transition-all active:scale-95 sm:hover:border-primary/50 cursor-zoom-in"
          data-index={index}
        >
          {item.type === "video" ? (
            <Fragment>
              <ProjectVideo src={item.src} title={item.alt} />
              <div class="absolute inset-0 flex flex-col items-center justify-center bg-muted/20">
                <div class="flex size-9 items-center justify-center rounded-full bg-background shadow-sm ring-1 ring-border">
                  <Play class="ml-0.5 size-4 text-primary" />
                </div>
              </div>
            </Fragment>
          ) : (
            <img
              src={item.src}
              alt={item.alt}
              class="size-full object-cover"
              loading="lazy"
            />
          )}

          <div class="absolute inset-0 bg-black/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <Maximize class="text-white size-5" stroke-width={2} />
          </div>

          <div class="absolute bottom-1.5 left-1.5 rounded bg-background/80 px-1 py-0.5 backdrop-blur-sm border border-border/50 flex items-center justify-center">
            <span class="text-[9px] font-mono font-bold uppercase opacity-70">
              {/* {item.type === "video" ? "vid" : "img"}-{padIndex(index)} */}
              {item.alt}
            </span>
          </div>
        </button>
      ))
    }
  </div>
</div>

<!-- borrowing laravel's snapshot idea for the data-gallery -->
<dialog
  id="gallery-dialog"
  data-gallery={mediaSerialized}
  class="m-auto w-full h-full max-h-dvh sm:h-auto overflow-hidden sm:rounded-2xl border-none sm:border border-border bg-background p-0 shadow-2xl backdrop:bg-background/95 backdrop:backdrop-blur-xl outline-none"
>
  <div class="flex flex-col h-full outline-none">
    {/* Responsive Header */}
    <div
      class="flex items-center justify-between border-b border-border bg-muted/10 px-4 py-3 z-50 select-none safe-top"
    >
      <span
        id="modal-counter"
        class="text-[10px] font-mono font-bold text-muted-foreground uppercase tracking-widest"
        >00 / 00</span
      >

      <span
        id="modal-title"
        class="text-[10px] font-mono font-bold text-muted-foreground uppercase tracking-widest"
        >Title</span
      >
      <div class="flex items-center gap-1 sm:gap-2">
        <a
          id="download-btn"
          href="#"
          download
          class="flex size-9 items-center justify-center rounded-lg border border-border bg-background text-foreground hover:bg-muted"
          title="Download"
        >
          <Download class="size-4" />
        </a>
        <div class="mx-0.5 h-4 w-px bg-border"></div>
        <button
          id="prev-btn"
          class="flex size-9 items-center justify-center rounded-lg border border-border bg-background text-foreground hover:bg-muted cursor-pointer"
          ><ChevronLeft class="size-5" /></button
        >
        <button
          id="next-btn"
          class="flex size-9 items-center justify-center rounded-lg border border-border bg-background text-foreground hover:bg-muted cursor-pointer"
          ><ChevronRight class="size-5" /></button
        >
        <form method="dialog">
          <button
            class="flex size-9 items-center justify-center rounded-lg border border-border bg-background text-foreground hover:bg-destructive/70 active:bg-destructive active:text-white cursor-pointer"
          >
            <X class="size-5" />
          </button>
        </form>
      </div>
    </div>

    {/* Viewport: Force 16/9 on Desktop, Flex-grow on Mobile */}
    <div
      id="modal-viewport"
      class="relative grow sm:aspect-video w-full bg-black flex items-center justify-center overflow-hidden outline-none"
    >
    </div>

    {/* Footer Legend: Hidden on tiny screens */}
    <div
      class="hidden sm:flex items-center justify-center gap-6 border-t border-border bg-muted/5 py-3 px-4 text-muted-foreground select-none"
    >
      <div
        class="flex items-center gap-1.5 font-mono text-[9px] font-bold uppercase tracking-tight"
      >
        <span class="rounded border border-border bg-background px-1 py-0.5"
          >Arrows
          <span class="inline-flex items-center gap-1">
            <kbd class="border-none shadow-none rounded-none">
              <kbd
                class="rounded border border-border bg-muted shadow-none inline-flex items-center justify-center h-5 min-w-5 px-1.5 font-mono text-[10px] font-medium text-muted-foreground select-none"
                >←</kbd
              >
              <kbd
                class="rounded border border-border bg-muted shadow-none inline-flex items-center justify-center h-5 min-w-5 px-1.5 font-mono text-[10px] font-medium text-muted-foreground select-none"
                >→</kbd
              >
            </kbd>
          </span>
        </span> Navigate
      </div>
      <div
        class="flex items-center gap-1.5 font-mono text-[9px] font-bold uppercase tracking-tight"
      >
        <span class="rounded border border-border bg-background px-1 py-0.5"
          >Pinch / Scroll</span
        > Zoom
      </div>
      <div
        class="flex items-center gap-1.5 font-mono text-[9px] font-bold uppercase tracking-tight"
      >
        <span class="rounded border border-border bg-background px-1 py-0.5"
          >2x Click/Tap</span
        > Reset
      </div>
    </div>
  </div>
</dialog>

<script type="module">
  import { onDoubleTap } from "/src/lib/utils/onDoubleTap";

  const dialog = document.getElementById("gallery-dialog");
  const viewport = document.getElementById("modal-viewport");
  const counter = document.getElementById("modal-counter");
  const title = document.getElementById("modal-title");
  const downloadBtn = document.getElementById("download-btn");
  const prevBtn = document.getElementById("prev-btn");
  const nextBtn = document.getElementById("next-btn");
  const triggers = document.querySelectorAll(".media-trigger");

  // Read the data from the attribute and parse it
  const rawData = dialog.dataset.gallery;
  const allMedia = JSON.parse(rawData);

  let currentIndex = 0;
  let scale = 1,
    translateX = 0,
    translateY = 0;
  let isDragging = false,
    startX,
    startY;
  let initialPinchDistance = 0;
  // swipe

  let touchStartX = 0;
  let isSwiping = false;
  const swipeThreshold = 50;

  const getEmbedUrl = (url) =>
    url.includes("youtube.com/watch?v=")
      ? url.replace("watch?v=", "embed/")
      : url;

  const applyTransform = (el) => {
    if (!el) return;
    el.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
  };

  const updateModal = (index) => {
    viewport.innerHTML = "";
    currentIndex = index;
    const item = allMedia[currentIndex];
    counter.innerText = `${index + 1} / ${allMedia.length}`;
    title.innerText = item.alt ? item.alt : null;
    downloadBtn.href = item.src;
    downloadBtn.style.display = item.type === "video" ? "none" : "flex";

    scale = 1;
    translateX = 0;
    translateY = 0;

    if (item.type === "video") {
      viewport.innerHTML = `<iframe src="${getEmbedUrl(item.src)}"  loading="lazy" class="h-full w-full border-0 select-none" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
    } else {
      viewport.innerHTML = `<img src="${item.src}" class="max-h-full max-w-full object-contain cursor-grab active:cursor-grabbing transition-transform duration-200 select-none" draggable="false"  loading="lazy" />`;
      initAdvancedControls(viewport.querySelector("img"));
    }
  };

  /** @param {HTMLImageElement} img */
  function initAdvancedControls(img) {
    // 1. Desktop Wheel Zoom
    viewport.onwheel = (e) => {
      e.preventDefault();
      const delta = e.deltaY > 0 ? -0.3 : 0.3;
      scale = Math.min(Math.max(1, scale + delta), 5);
      if (scale === 1) {
        translateX = 0;
        translateY = 0;
      }
      applyTransform(img);
    };

    // 2. Double Tap / Double Click Reset
    img.ondblclick = () => {
      scale = scale > 1 ? 1 : 2.5;
      translateX = 0;
      translateY = 0;
      applyTransform(img);
    };

    const handleDoubleTap = onDoubleTap({
      callback: (e) => {
        scale = scale > 1 ? 1 : 2.5;
        translateX = 0;
        translateY = 0;
        applyTransform(img);
      },
      delay: 300,
      tolerance: 25,
    });

    // 3. Mouse Drag
    img.onmousedown = (e) => {
      if (scale === 1) return;
      isDragging = true;
      startX = e.clientX - translateX;
      startY = e.clientY - translateY;
    };

    // 4. Mobile Touch (Pinch & Pan)
    img.ontouchstart = (e) => {
      if (e.touches.length === 2) {
        initialPinchDistance = Math.hypot(
          e.touches[0].pageX - e.touches[1].pageX,
          e.touches[0].pageY - e.touches[1].pageY,
        );
      } else if (e.touches.length === 1) {
        if (scale <= 1) {
          isSwiping = true;
          touchStartX = e.touches[0].clientX;
          img.style.transition = "none";
        }

        if (scale > 1) {
          isDragging = true;
          startX = e.touches[0].clientX - translateX;
          startY = e.touches[0].clientY - translateY;
        }
      }
    };

    img.ontouchmove = (e) => {
      if (e.touches.length === 2) {
        e.preventDefault();
        const dist = Math.hypot(
          e.touches[0].pageX - e.touches[1].pageX,
          e.touches[0].pageY - e.touches[1].pageY,
        );
        const delta = dist / initialPinchDistance;
        scale = Math.min(Math.max(1, scale * delta), 5);
        initialPinchDistance = dist;
        applyTransform(img);
      } else if (isDragging && e.touches.length === 1) {
        translateX = e.touches[0].clientX - startX;
        translateY = e.touches[0].clientY - startY;
        applyTransform(img);
      } else if (isSwiping && scale === 1) {
        const currentX = e.touches[0].clientX;
        translateX = currentX - touchStartX;
        applyTransform(img);
      }
    };

    // img.ontouchend = () => (isDragging = false);

    img.ontouchend = (e) => {
      // We only handle swipe/doubletap if it was a single finger interaction
      if (e.changedTouches.length === 1 || isSwiping) {
        isSwiping = false;
        img.style.transition = "transform 0.3s cubic-bezier(0.2, 1, 0.3, 1)";
        const touchEndX = e.changedTouches[0].clientX;
        const deltaX = touchEndX - touchStartX;

        // SWIPE: Only swipe if we are NOT zoomed in
        if (scale === 1 && Math.abs(deltaX) > swipeThreshold) {
          const direction = translateX > 0 ? "prev" : "next";

          translateX = translateX > 0 ? window.innerWidth : -window.innerWidth;
          applyTransform(img);

          // Wait for exit animation, then load next
          setTimeout(() => {
            updateModal(
              direction === "prev"
                ? (currentIndex - 1 + allMedia.length) % allMedia.length
                : (currentIndex + 1) % allMedia.length,
              direction,
            );
          }, 200);
        } else {
          // Snap Back
          translateX = 0;
          applyTransform(img);
        }
      }

      isDragging = false;
      // 2x tap
      if (e.touches.length === 0) {
        handleDoubleTap(e);
      }
    };
  }

  window.onmousemove = (e) => {
    if (!isDragging) return;
    translateX = e.clientX - startX;
    translateY = e.clientY - startY;
    applyTransform(viewport.querySelector("img"));
  };

  window.onmouseup = () => (isDragging = false);

  window.addEventListener("keydown", (e) => {
    if (!dialog.open) return;
    if (e.key === "ArrowLeft")
      updateModal((currentIndex - 1 + allMedia.length) % allMedia.length);
    if (e.key === "ArrowRight")
      updateModal((currentIndex + 1) % allMedia.length);
  });

  const stopMedia = () => {
    viewport.innerHTML = "";
  };

  dialog.addEventListener("close", stopMedia);

  triggers.forEach((t) =>
    t.addEventListener("click", () => {
      updateModal(parseInt(t.dataset.index));
      dialog.showModal();
    }),
  );

  prevBtn.onclick = () =>
    updateModal((currentIndex - 1 + allMedia.length) % allMedia.length);
  nextBtn.onclick = () => updateModal((currentIndex + 1) % allMedia.length);
  dialog.onclick = (e) => {
    if (e.target === dialog) dialog.close();
  };
</script>

<style is:global>
  /* SAFE AREA FOR MODERN PHONES */
  .safe-top {
    padding-top: max(0.75rem, env(safe-area-inset-top));
  }

  #gallery-dialog {
    touch-action: none; /* Prevents browser pull-to-refresh while zoomed */
  }

  #modal-viewport iframe {
    /* Mobile fix for iframes not obeying rounding */
    border-radius: 0;
  }

  @media (max-width: 640px) {
    #gallery-dialog {
      border-radius: 0;
    }
  }

  dialog[open]::backdrop {
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(15px);
  }

  /* Prevent double scrollbars on the HTML/Body level */
  html:has(dialog[open]),
  body:has(dialog[open]) {
    overflow: hidden !important;
    /* Prevents the "jumping" effect when scrollbar disappears */
    padding-right: var(--scrollbar-gutter, 0px);
  }

  /* Strip default dialog scrollbars */
  #gallery-dialog {
    overflow: hidden !important;
    scrollbar-width: none; /* Firefox */
  }

  #gallery-dialog::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  /* Ensure the viewport handles the content sizing */
  #modal-viewport {
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #modal-viewport img {
    transition:
      transform 0.2s ease-out,
      opacity 0.2s ease-in-out;
  }
</style>
