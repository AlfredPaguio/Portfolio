---
import { cn } from "@/lib/utils/cn";

interface Props {
  status: "active" | "maintenance" | "archived" | "unknown";
  class?: string;
}

const { status, class: className } = Astro.props;

// I'm tired to make this into class variance authority
const statusStyles = {
  active: {
    label: "Active",
    color: "text-emerald-500 dark:text-green-400",
    dot: "bg-green-500",
    bg: "bg-emerald-500/10 dark:bg-green-900/20",
    border: "border-emerald-500/20 dark:border-green-800/50",
  },
  maintenance: {
    label: "In maintenance",
    color: "text-amber-500 dark:text-amber-400",
    dot: "bg-amber-500",
    bg: "bg-amber-500/10 dark:bg-amber-900/20",
    border: "border-amber-500/20 dark:border-amber-800/50",
  },
  archived: {
    label: "Archived",
    color: "text-muted-foreground",
    dot: "bg-neutral-400",
    bg: "bg-muted",
    border: "border-border",
  },
  unknown: {
    label: "Unknown",
    color: "text-muted-foreground",
    dot: "bg-border",
    bg: "bg-muted",
    border: "border-border",
  },
};

const config = statusStyles[status] || statusStyles.unknown;
---

<div
  class={cn(
    "inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full border text-[10px] font-bold uppercase tracking-wider",
    config.bg,
    config.border,
    config.color,
    className,
  )}
>
  <span
    aria-hidden="true"
    class={cn(
      "size-1.5 rounded-full",
      config.dot,
      status === "active" && "animate-pulse",
    )}></span>
  {config.label}
</div>
