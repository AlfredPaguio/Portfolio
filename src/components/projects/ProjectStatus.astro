---
import { cn } from "@/lib/utils/cn";

interface Props {
  status: "active" | "maintenance" | "archived" | "unknown";
  class?: string;
  compact?: boolean;
  label?: string;
  accessibleLabel?: string;
}

const {
  status,
  class: className,
  compact = false,
  label,
  accessibleLabel,
} = Astro.props;

// I'm tired to make this into class variance authority
const statusStyles = {
  active: {
    label: "Active",
    color: "text-emerald-700 dark:text-emerald-300",
    dot: "bg-emerald-600 dark:bg-emerald-400",
    bg: "bg-emerald-500/10 dark:bg-green-900/20",
    border: "border-emerald-500/30 dark:border-emerald-400/30",
  },
  maintenance: {
    label: "In maintenance",
    color: "text-amber-800 dark:text-amber-300",
    dot: "bg-amber-700 dark:bg-amber-300",
    bg: "bg-amber-500/10 dark:bg-amber-900/20",
    border: "border-amber-600/30 dark:border-amber-300/30",
  },
  archived: {
    label: "Archived",
    color: "text-muted-foreground",
    dot: "bg-neutral-400",
    bg: "bg-muted",
    border: "border-border",
  },
  unknown: {
    label: "Unknown",
    color: "text-muted-foreground",
    dot: "bg-border",
    bg: "bg-muted",
    border: "border-border",
  },
};

const config = statusStyles[status] || statusStyles.unknown;
const compactLabels = {
  active: "Active",
  maintenance: "Maintenance",
  archived: "Archived",
  unknown: "Unknown",
} as const;
const visibleLabel = label ?? (compact ? compactLabels[status] : config.label);
const spokenLabel =
  accessibleLabel ??
  (status === "unknown" ? "Current status unknown" : visibleLabel);
---

<div
  class={cn(
    "inline-flex items-center gap-1.5 whitespace-nowrap rounded-sm border px-2 py-1 text-[10px] font-bold uppercase tracking-wider",
    compact && "gap-1 px-1.5 py-0.5 font-mono tracking-normal",
    config.bg,
    config.border,
    config.color,
    className,
  )}>
  <span aria-hidden="true" class={cn("size-1.5 rounded-full", config.dot)}
  ></span>
  {status === "unknown" && <span class="sr-only">{spokenLabel}</span>}
  <span aria-hidden={status === "unknown" ? "true" : undefined}>
    {visibleLabel}
  </span>
</div>
