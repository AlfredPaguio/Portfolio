---
import { cn } from "@/lib/utils/cn";
import { Archive, CircleDot, QuestionMark, Wrench } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";

const statusBadgeVariants = cva(
  "inline-flex h-5 items-center gap-1 whitespace-nowrap rounded-full px-2 text-[10px] font-medium uppercase tracking-wider ring-1 ring-inset transition-colors [&_svg]:shrink-0 [&_svg]:size-3",
  {
    variants: {
      status: {
        active:
          "bg-status-active/10 text-status-active-foreground ring-status-active/25",
        maintenance:
          "bg-status-maintenance/12 text-status-maintenance-foreground ring-status-maintenance/30",
        archived: "bg-muted/60 text-muted-foreground ring-border",
        unknown: "bg-muted/60 text-muted-foreground ring-border",
      },
      compact: {
        true: "h-4 gap-0.5 px-1.5 text-[9px] font-mono tracking-normal [&_svg]:size-2.5",
        false: "",
      },
    },
    defaultVariants: { status: "unknown", compact: false },
  },
);

const statusIcons = {
  active: CircleDot,
  maintenance: Wrench,
  archived: Archive,
  unknown: QuestionMark,
} as const;

const statusLabels = {
  active: "Active",
  maintenance: "In maintenance",
  archived: "Archived",
  unknown: "Unknown",
} as const;

const compactLabels = {
  active: "Active",
  maintenance: "Maintenance",
  archived: "Archived",
  unknown: "Unknown",
} as const;

export type StatusBadgeVariantProps = VariantProps<typeof statusBadgeVariants>;

type BaseProps = {
  label?: string;
  accessibleLabel?: string;
} & HTMLAttributes<"div">;

export type Props = BaseProps & StatusBadgeVariantProps;

const {
  status: statusProp = "unknown",
  compact = false,
  class: className,
  label,
  accessibleLabel,
  ...props
} = Astro.props;

const status = statusProp ?? "unknown";
const isCompact = compact ?? false;
const Icon = statusIcons[status];

const visibleLabel =
  label ?? (isCompact ? compactLabels[status] : statusLabels[status]);
const spokenLabel =
  accessibleLabel ??
  (status === "unknown" ? "Current status unknown" : visibleLabel);
---

<div
  data-slot="status-badge"
  data-status={status}
  class={cn(statusBadgeVariants({ status, compact: isCompact }), className)}
  {...props}>
  <Icon aria-hidden="true" stroke-width={2.75} />
  {status === "unknown" && <span class="sr-only">{spokenLabel}</span>}
  <span aria-hidden={status === "unknown" ? "true" : undefined}>
    {visibleLabel}
  </span>
</div>
