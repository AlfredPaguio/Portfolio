---
import { navItems } from "@/data/nav";
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import Button from "@/components/ui/Button.astro";


const currentPath = Astro.url.pathname;
---

<div class="md:hidden flex items-center">
  <Button
    variant="ghost"
    size="icon-lg"
    id="menu-button"
    class="p-2 -mr-2 transition-colors focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-md cursor-pointer relative"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Toggle navigation menu"
  >
    <Menu
      class="size-5 transition-all duration-300 ease-in-out
            motion-reduce:transition-none
             rotate-0 scale-100
             in-aria-expanded:-rotate-90 in-aria-expanded:scale-0"
    />
    <X
      class="absolute size-5 transition-all duration-300 ease-in-out
             motion-reduce:transition-none
             rotate-90 scale-0
             in-aria-expanded:rotate-0 in-aria-expanded:scale-100"
    />
  </Button>

  <div
    id="mobile-menu"
    data-state="closed"
    role="menu"
    aria-labelledby="menu-button"
    class="fixed inset-x-4 top-22 z-50
         flex flex-col gap-1 p-1.5 rounded-2xl
         border border-border/60 bg-card
         backdrop-blur-xl shadow-lg
         ring-1 ring-black/5 dark:ring-white/5
         opacity-0 translate-y-2 scale-[0.98]
         pointer-events-none invisible
         data-[state=open]:opacity-100
         data-[state=open]:translate-y-0
         data-[state=open]:scale-100
         data-[state=open]:pointer-events-auto
         data-[state=open]:visible
         transition-all duration-200 ease-out
         motion-reduce:transition-none
         overflow-hidden"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          role="menuitem"
          class:list={[
            "relative px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-150 focus:outline-hidden focus:ring-2 focus:ring-ring/50 focus:ring-offset-1",
            currentPath === item.href
              ? "bg-primary text-primary-foreground shadow-sm"
              : "hover:bg-muted/70 active:scale-[0.98]",
          ]}
        >
          {item.label}
          {currentPath !== item.href && (
            <span
              class="absolute inset-0 rounded-xl in-focus:bg-accent/5 transition-colors duration-150"
              aria-hidden="true"
            />
          )}
        </a>
      ))
    }
  </div>
</div>

<script is:inline>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");

  const toggleMenu = () => {
    const isExpanded = button?.getAttribute("aria-expanded") === "true";
    button?.setAttribute("aria-expanded", !isExpanded ? "true" : "false");
    menu?.setAttribute("data-state", !isExpanded ? "open" : "closed");
  };

  button?.addEventListener("click", (e) => {
    e.stopPropagation();
    toggleMenu();
  });

  // Close when clicking outside
  document.addEventListener("click", (e) => {
    if (
      button?.getAttribute("aria-expanded") === "true" &&
      !menu?.contains(e.target)
    ) {
      toggleMenu();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      button?.getAttribute("aria-expanded") === "true"
    ) {
      toggleMenu();
      button?.focus();
    }
  });

  menu?.querySelectorAll('a[role="menuitem"]').forEach((link) => {
    link.addEventListener("click", () => {
      toggleMenu();
    });
  });
</script>
