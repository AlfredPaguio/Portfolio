---
import { navItems } from "@/data/nav";
import Button from "@/components/ui/Button.astro";
import { navigationIcons } from "./navigationIcons";

const currentPath = Astro.url.pathname;
---

<nav class="flex items-center gap-1" aria-label="Main navigation">
  {
    navItems.map((item) => {
      const Icon = navigationIcons[item.href as keyof typeof navigationIcons];
      const isActive =
        currentPath === item.href ||
        (item.href !== "/" && currentPath.startsWith(`${item.href}/`));
      return (
        <Button
          variant="ghost"
          href={item.href}
          class:list={[
            "relative min-h-11 gap-2 px-3 py-2 text-sm font-medium transition-colors rounded-lg touch-manipulation",
            isActive
              ? "bg-muted text-foreground font-semibold hover:bg-muted"
              : "hover:bg-muted text-muted-foreground hover:text-foreground",
          ]}
          aria-current={isActive ? "page" : undefined}
        >
          <Icon class="size-4" aria-hidden="true" />
          {item.label}
        </Button>
      );
    })
  }
</nav>
