---
import { siteConfig } from "@/data/site";
import { Font } from "astro:assets";

const {
  title: _title,
  description: _openGraphDescription,
  openGraphImage: _openGraphImage,
  openGraphType,
  ...props
} = Astro.props;

const title = _title ? `${_title} | Alfred's Portfolio` : "Alfred's Portfolio";
const openGraphImage = _openGraphImage
  ? _openGraphImage
  : new URL("/og/main.png", Astro.url.origin).href;
const description = _openGraphDescription
  ? _openGraphDescription
  : siteConfig.description;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <link
    rel="alternate"
    type="application/rss+xml"
    title={siteConfig.name}
    href={new URL("rss.xml", Astro.site)}
  />
  <meta property="og:site_name" content={siteConfig.name} />

  <Font cssVariable="--font-geist-sans" preload />
  <Font cssVariable="--font-geist-mono" preload />
  <Font cssVariable="--font-noto-sans-jp" preload />

  {description ? <meta name="description" content={description} /> : null}
  {
    description ? (
      <meta property="og:description" content={description} />
    ) : null
  }

  <meta property="og:title" content={title} />
  {openGraphType ? <meta property="og:type" content={openGraphType} /> : null}
  {
    openGraphImage ? (
      <meta property="og:image" content={openGraphImage} />
    ) : null
  }
  <meta property="og:url" content={Astro.url.href} />
</head>
