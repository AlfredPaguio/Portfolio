---
import { siteConfig } from "@/data/site";
import { SEO } from "astro-seo";
import { Font } from "astro:assets";

const {
  title: _title,
  description: _openGraphDescription,
  openGraphImage: _openGraphImage,
  openGraphType = "website",
  ...props
} = Astro.props;

const title = _title ? `${_title} | Alfred's Portfolio` : "Alfred's Portfolio";
const openGraphImage = new URL(
  _openGraphImage || "/og/main.png",
  Astro.site ?? Astro.url,
).href;
const description = _openGraphDescription
  ? _openGraphDescription
  : siteConfig.description;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f2f2f2" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <link
    rel="alternate"
    type="text/plain"
    title="Portfolio in Markdown"
    href="/llms-full.txt"
  />

  <SEO
    title={title}
    description={description}
    canonical={canonicalURL}
    openGraph={{
      basic: {
        title,
        type: openGraphType || "website",
        image: openGraphImage,
        url: canonicalURL,
      },
      optional: { description, siteName: siteConfig.name },
      image: {
        secureUrl: openGraphImage,
        type: "image/png",
        width: 1200,
        height: 630,
        alt: title,
      },
    }}
    twitter={{
      card: "summary_large_image",
      title,
      description,
      image: openGraphImage,
      imageAlt: title,
    }}
    extend={{
      meta: [
        { name: "title", content: title },
        { name: "twitter:url", content: canonicalURL.href },
      ],
    }}
  />

  <link
    rel="alternate"
    type="application/rss+xml"
    title={siteConfig.name}
    href={new URL("rss.xml", Astro.site)}
  />

  <Font cssVariable="--font-geist-sans" preload />
  <Font cssVariable="--font-geist-mono" preload />

  <!-- Fav Icon -->
  <link
    rel="icon"
    type="image/png"
    href="/fav-icons/favicon-96x96.png"
    sizes="96x96"
  />
  <link rel="icon" type="image/svg+xml" href="/fav-icons/favicon.svg" />
  <link rel="shortcut icon" href="/fav-icons/favicon.ico" />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/fav-icons/apple-touch-icon.png"
  />
  <meta name="apple-mobile-web-app-title" content="Alfred's Portfolio" />
  <link rel="manifest" href="/fav-icons/site.webmanifest" />
  <link rel="sitemap" href="/sitemap-index.xml" />
</head>
