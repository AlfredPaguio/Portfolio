---
import { siteConfig } from "@/data/site";
import { Font } from "astro:assets";

const {
  title: _title,
  description: _openGraphDescription,
  openGraphImage: _openGraphImage,
  openGraphType = "website",
  ...props
} = Astro.props;

const title = _title ? `${_title} | Alfred's Portfolio` : "Alfred's Portfolio";
const openGraphImage = _openGraphImage
  ? _openGraphImage
  : new URL("/og/main.png", Astro.url.origin).href;
const description = _openGraphDescription
  ? _openGraphDescription
  : siteConfig.description;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <link rel="canonical" href={canonicalURL} />

  <title>{title}</title>

  <meta name="title" content={title} />
  <meta name="description" content={description} />

  <meta property="og:type" content={openGraphType} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={openGraphImage} />
  <meta property="og:image:secure_url" content={openGraphImage} />  
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content={siteConfig.name} />
  
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url.href} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={openGraphImage} />

  <link
    rel="alternate"
    type="application/rss+xml"
    title={siteConfig.name}
    href={new URL("rss.xml", Astro.site)}
  />

  <Font cssVariable="--font-geist-sans" preload />
  <Font cssVariable="--font-geist-mono" preload />
  <Font cssVariable="--font-noto-sans-jp" preload />

  <!-- Fav Icon -->
  <link
    rel="icon"
    type="image/png"
    href="/fav-icons/favicon-96x96.png"
    sizes="96x96"
  />
  <link rel="icon" type="image/svg+xml" href="/fav-icons/favicon.svg" />
  <link rel="shortcut icon" href="/fav-icons/favicon.ico" />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/fav-icons/apple-touch-icon.png"
  />
  <meta name="apple-mobile-web-app-title" content="Alfred's Portfolio" />
  <link rel="manifest" href="/fav-icons/site.webmanifest" />
</head>
