---
import Section from "@/components/Section.astro";
import BaseLayout from "./BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import MoveLeft from "@lucide/astro/icons/move-left";

const { frontmatter, openGraphImage, ...props } = Astro.props;
const lastUpdated = frontmatter.last_updated
  ? new Date(`${frontmatter.last_updated}T00:00:00Z`)
  : null;
const formattedLastUpdated = lastUpdated
  ? lastUpdated.toLocaleDateString("en-US", {
      dateStyle: "long",
      timeZone: "UTC",
    })
  : null;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.summary}
  openGraphImage={openGraphImage || null}
  {...props}>
  <div class="mx-auto max-w-3xl space-y-8 sm:space-y-10">
    <header class="max-w-[70ch]">
      <nav class="mb-5">
        <Button
          href="/"
          variant="ghost"
          size="sm"
          class="-ml-3 text-muted-foreground hover:text-foreground">
          <MoveLeft class="mr-2" aria-hidden="true" /> Back to home
        </Button>
      </nav>

      <div class="space-y-4">
        <h1 class="text-4xl font-extrabold tracking-[-0.03em] text-balance sm:text-5xl">
          {frontmatter.title}
        </h1>
        {
          frontmatter.summary && (
            <p class="max-w-[60ch] text-lg leading-relaxed text-muted-foreground sm:text-xl">
              {frontmatter.summary}
            </p>
          )
        }
        {
          formattedLastUpdated && (
            <p class="text-sm text-muted-foreground">
              Updated <time datetime={frontmatter.last_updated}>{formattedLastUpdated}</time>
            </p>
          )
        }
      </div>
    </header>

    <!-- This is where the [slug].astro logic will inject the metadata grid -->
    <slot name="metadata" />

    <Section
      class="prose dark:prose-invert max-w-[70ch] border-t border-border pt-6! py-0 prose-headings:scroll-mt-28 prose-headings:tracking-tight prose-p:leading-[1.8] prose-li:leading-[1.8] prose-a:underline-offset-4 wrap-break-word sm:pt-7!">
      <slot />
    </Section>
  </div>
</BaseLayout>
