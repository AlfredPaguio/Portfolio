---
import Section from "@/components/Section.astro";
import BaseLayout from "./BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import MoveLeft from "@lucide/astro/icons/move-left";

const { frontmatter, openGraphImage, ...props } = Astro.props;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.summary}
  openGraphImage={openGraphImage || null}
  {...props}
>
  <div class="space-y-8">
    <header>
      <nav class="mb-4">
        <Button
          href="/projects"
          variant="ghost"
          size="sm"
          class="-ml-3 text-muted-foreground hover:text-foreground"
        >
          <MoveLeft class="mr-2" /> Back to Project list
        </Button>
      </nav>

      <div class="space-y-4">
        <h1 class="text-4xl font-extrabold tracking-tighter sm:text-6xl">
          {frontmatter.title}
        </h1>
        {
          frontmatter.summary && (
            <p class="text-xl text-muted-foreground leading-relaxed max-w-2xl">
              {frontmatter.summary}
            </p>
          )
        }
      </div>
    </header>

    <!-- This is where the [slug].astro logic will inject the metadata grid -->
    <slot name="metadata" />

    <Section
      className="prose dark:prose-invert border-t border-border pt-4! py-0 max-w-none"
    >
      <slot />
    </Section>

    <nav class="mt-4 flex justify-end-safe items-center-safe w-full">
      <Button
        href="/projects"
        variant="ghost"
        size="sm"
        class="-ml-3 text-muted-foreground hover:text-foreground"
      >
        <MoveLeft class="mr-2" /> Back to Project list
      </Button>
    </nav>
  </div>
</BaseLayout>
