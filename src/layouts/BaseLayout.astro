---
import "@/assets/styles/global.css";
import Footer from "@/components/footer/Footer.astro";
import Head from "@/components/Head.astro";
import Header from "@/components/Header.astro";

interface Props {
  title?: string | null;
  description?: string | null;
  openGraphImage?: string | null;
  openGraphType?: string | null;
}

const { title, description, openGraphImage, openGraphType, ...props } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <Head {title} {description} {openGraphImage} {openGraphType} {...props} />
  <body class="relative min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only absolute top-4 left-4 bg-primary text-primary-foreground p-2 rounded-md z-50"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="main"
      class="max-w-3xl mx-auto px-6 pt-32 pb-8 min-h-[calc(100vh-80px)]"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
