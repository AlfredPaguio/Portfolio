---
import "@/assets/styles/global.css";
import Footer from "@/components/footer/Footer.astro";
import Header from "@/components/Header.astro";

interface Props {
  title?: string | null;
  description?: string | null;
}

const { title: _title, description, ...props } = Astro.props;

const title = _title ? `${_title} | Alfred's Portfolio` : "Alfred's Portfolio";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="relative min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only absolute top-4 left-4 bg-primary text-primary-foreground p-2 rounded-md z-50"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="main"
      class="max-w-3xl mx-auto px-6 pt-32 pb-8 min-h-[calc(100vh-80px)]"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
