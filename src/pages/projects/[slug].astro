---
import MarkdownLayout from "@/layouts/MarkdownLayout.astro";
import { getCollection, render } from "astro:content";
import { components } from "@/components/mdx";
import TechPill from "@/components/TechPill.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const statusColors = {
  active: "text-green-600 bg-green-50 dark:bg-green-900/20 border-green-200",
  maintenance:
    "text-amber-600 bg-amber-50 dark:bg-amber-900/20 border-amber-200",
  archived:
    "text-neutral-500 bg-neutral-50 dark:bg-neutral-900/20 border-neutral-200",
  unknown: "text-muted-foreground bg-muted border-border",
};
---

<MarkdownLayout frontmatter={project.data}>
  <!-- <div class="tags">
    {
      project.data.stack?.map((tag: string) => (
        <p class="tag">
          <a href={`/tags/${tag}`}>{tag}</a>
        </p>
      ))
    }
  </div> -->
  <div
    class="flex flex-wrap items-center gap-4 mb-10 pb-8 border-b border-border"
  >
    {
      project.data.status && (
        <span
          class:list={[
            "text-[10px] uppercase font-bold px-2 py-1 rounded border",
            statusColors[project.data.status],
          ]}
        >
          {project.data.status}
        </span>
      )
    }

    <div class="flex flex-wrap gap-2">
      {
        project.data.stack.map((techId: string) => (
          // TechPill handles the lookup/icon. techId should match filenames in content/techs
          <TechPill id={techId.toLowerCase()} />
        ))
      }
    </div>
  </div>

  {
    project.data.links.length > 0 && (
      <div class="flex flex-wrap gap-3 mb-12">
        {project.data.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            class="inline-flex items-center px-4 py-2 rounded-xl border border-border bg-background hover:bg-muted text-sm font-bold transition-colors"
          >
            {/* {link.type === "source" && <span class="mr-2">GitHub</span>}
            {link.type === "demo" && <span class="mr-2">Live</span>} */}
            {link.label}
          </a>
        ))}
      </div>
    )
  }

  <Content {components} />
</MarkdownLayout>
