---
import MarkdownLayout from "@/layouts/MarkdownLayout.astro";
import { getCollection, render } from "astro:content";
import { components } from "@/components/mdx";
import TechPill from "@/components/TechPill.astro";
import ExternalLink from "@/components/ExternalLink.astro";
import ProjectStatus from "@/components/projects/ProjectStatus.astro";
import FolderGit from "@lucide/astro/icons/folder-git";
import Globe from "@lucide/astro/icons/globe";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const dateStr = project.data.date
  ? new Intl.DateTimeFormat("en-US", {
      month: "long",
      year: "numeric",
    }).format(new Date(project.data.date))
  : "Ongoing";
---

<MarkdownLayout frontmatter={project.data}>
  <div slot="metadata" class="flex flex-wrap items-center gap-4">
    {
      project.data.status && (
        <Fragment>
          <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/60">
            Project Status:
          </span>
          <ProjectStatus status={project.data.status} />
          <span class="text-xs font-mono text-muted-foreground">{dateStr}</span>
        </Fragment>
      )
    }

    <div class="flex flex-wrap gap-2">
      <span
        class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/60"
        >Tech Used:</span
      >
      {
        project.data.stack.map((techId: string) => (
          // TechPill handles the lookup/icon. techId should match filenames in content/techs
          <TechPill id={techId.toLowerCase()} />
        ))
      }
    </div>

    {
      project.data.links.length > 0 && (
        <div class="flex flex-wrap gap-3">
          <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/60">
            Link(s):
          </span>
          {project.data.links.map((link) => (
            <ExternalLink href={link.url} class="text-xs">
              {link.type === "source" && <FolderGit class="opacity-50" />}
              {link.type === "demo" && <Globe class="opacity-50" />}
              {link.label}
            </ExternalLink>
          ))}
        </div>
      )
    }
  </div>

  <Content {components} />
</MarkdownLayout>
