---
import { components } from "@/components/mdx";
import ProjectMedia from "@/components/projects/ProjectMedia.astro";
import RecruiterCopy from "@/components/RecruiterCopy.astro";
import TechPill from "@/components/TechPill.astro";
import Button from "@/components/ui/Button.astro";
import { frontmatter as resume } from "@/content/resumes.md";
import { projectBriefs } from "@/data/project-briefs";
import { siteConfig } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { normalizeTech } from "@/lib/utils/normalizeTech";
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import ExternalLink from "@lucide/astro/icons/external-link";
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { linkIcons } from "./_components/linkIcons";

export const getStaticPaths = (async () => {
  return (await getCollection("projects")).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { data, id } = project;
const brief = projectBriefs[id];
const { Content, remarkPluginFrontmatter } = await render(project);
const dateStr = data.date
  ? new Intl.DateTimeFormat("en-US", {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }).format(data.date)
  : null;
const availableLinks = data.links.filter((link) => !link.disabled);
const unavailableLinks = data.links.filter((link) => link.disabled);
const cover =
  id === "project-management-app"
    ? data.images.find((image) => image.src.includes("03-dashboard")) ||
      data.images[0]
    : data.images[0];
const hasMedia = data.images.length > 0 || data.videos.length > 0;
const statusLabels = {
  active: "Active project",
  maintenance: "In maintenance",
  archived: "Archived project",
  unknown: "Current status unconfirmed",
};
const focus =
  "focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-4";
---

<BaseLayout
  title={data.title}
  description={brief?.purpose || data.summary}
  openGraphImage={`${Astro.url.origin}/og/projects/${id}.png`}
  openGraphType="project"
>
  <nav aria-label="Project navigation" class="mb-8">
    <a
      href="/projects/"
      class:list={[
        "inline-flex min-h-10 items-center gap-2 rounded text-sm text-muted-foreground hover:text-foreground",
        focus,
      ]}><ArrowLeft class="size-4" aria-hidden="true" />All projects</a
    >
  </nav>

  <header class="mb-10">
    <div
      class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground"
    >
      {brief && <span>{brief.category}</span>}
      {dateStr && <time datetime={data.date!.toISOString()}>{dateStr}</time>}
      <span class="inline-flex items-center gap-2"
        >{
          data.status === "active" && (
            <span
              class="size-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400"
              aria-hidden="true"
            />
          )
        }{statusLabels[data.status]}</span
      >
    </div>
    <h1
      class="max-w-[22ch] text-4xl leading-[1.1] font-bold tracking-tight text-balance sm:text-5xl"
    >
      {data.title}
    </h1>
    <p
      class="mt-5 max-w-[65ch] text-lg leading-relaxed text-pretty text-muted-foreground"
    >
      {brief?.purpose || data.summary}
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      {
        availableLinks
          .filter((link) => link.type === "demo" || link.type === "source")
          .map((link) => {
            const Icon = linkIcons[link.type] ?? ExternalLink;
            return (
              <Button
                href={link.url}
                variant={link.type === "demo" ? "default" : "outline"}
                size="lg"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon class="size-4" aria-hidden="true" />
                {link.type === "demo" ? "Try live demo" : "View source code"}
                <span class="sr-only"> (opens in a new tab)</span>
              </Button>
            );
          })
      }
      {
        hasMedia && (
          <a
            href="#screenshots"
            class:list={[
              "inline-flex min-h-10 items-center rounded px-2 text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground",
              focus,
            ]}
          >
            View screenshots
          </a>
        )
      }
    </div>
    <div class="mt-5">
      <RecruiterCopy src={`/projects/${id}.md`} project compact />
    </div>
    {
      unavailableLinks.length > 0 && (
        <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
          Currently unavailable:{" "}
          {unavailableLinks.map((link) => link.label).join(", ")}.
        </p>
      )
    }
  </header>

  {
    brief && (
      <section
        aria-labelledby="work-heading"
        class:list={[
          "mb-10 grid gap-6 rounded-xl border border-border bg-card p-5 sm:p-6",
          cover && "md:grid-cols-[1fr_1.15fr] md:items-center md:gap-8",
        ]}
      >
        <div>
          <h2 id="work-heading" class="text-lg font-semibold tracking-tight">
            The work behind this project
          </h2>
          <p class="mt-3 text-base leading-relaxed text-muted-foreground">
            {brief.highlight}
          </p>
          <a
            href="#project-details"
            class:list={[
              "mt-4 inline-flex min-h-10 items-center rounded text-sm font-medium underline underline-offset-4 hover:text-muted-foreground",
              focus,
            ]}
          >
            Explore the implementation
          </a>
        </div>
        {cover && (
          <a
            href="#screenshots"
            class:list={[
              "block overflow-hidden rounded-lg bg-muted p-3",
              focus,
            ]}
            aria-label={`See screenshots of ${data.title}`}
          >
            <img
              src={cover.src}
              alt={cover.alt || `${data.title} preview`}
              width={800}
              height={450}
              loading="eager"
              fetchpriority="high"
              class:list={[
                "aspect-video w-full rounded",
                id === "project-management-app"
                  ? "object-cover object-top"
                  : "object-contain",
              ]}
            />
          </a>
        )}
      </section>
    )
  }

  <div
    class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-12"
  >
    <div class="min-w-0">
      <section
        id="project-details"
        aria-labelledby="details-heading"
        class="scroll-mt-28"
      >
        <div
          class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-4"
        >
          <h2 id="details-heading" class="text-xl font-semibold tracking-tight">
            Project details
          </h2>
          {
            remarkPluginFrontmatter?.minutesRead && (
              <span class="text-xs text-muted-foreground">
                {remarkPluginFrontmatter.minutesRead}
              </span>
            )
          }
        </div>
        <div
          class="prose prose-sm max-w-none text-foreground dark:prose-invert prose-headings:scroll-mt-28 prose-headings:tracking-tight prose-p:leading-[1.8] prose-li:leading-[1.8] prose-a:underline-offset-4 prose-img:rounded-lg wrap-break-word sm:prose-base"
        >
          <Content {components} />
        </div>
      </section>
      {
        hasMedia && (
          <section
            id="screenshots"
            aria-label="Screenshots and demos"
            class="scroll-mt-28"
          >
            <ProjectMedia images={data.images} videos={data.videos} />
          </section>
        )
      }
    </div>

    <aside
      aria-label="Project tools and technologies"
      class="row-start-1 space-y-8 lg:sticky lg:top-28 lg:col-start-2 lg:row-start-auto"
    >
      <section aria-labelledby="stack-heading">
        <h2 id="stack-heading" class="mb-4 text-sm font-semibold">
          Built with
        </h2>
        <div class="flex flex-wrap gap-2">
          {
            data.stack.map((techId) => {
              const tech = normalizeTech(techId);
              return (
                <TechPill
                  id={tech.id}
                  version={tech.version}
                  showVersion={false}
                  class="font-medium"
                />
              );
            })
          }
        </div>
      </section>
      {
        availableLinks.some(
          (link) => link.type !== "demo" && link.type !== "source",
        ) && (
          <section aria-labelledby="links-heading">
            <h2 id="links-heading" class="mb-3 text-sm font-semibold">
              More links
            </h2>
            <div class="flex flex-col items-start gap-2">
              {availableLinks
                .filter(
                  (link) => link.type !== "demo" && link.type !== "source",
                )
                .map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      "inline-flex min-h-9 items-center gap-2 rounded text-sm text-muted-foreground hover:text-foreground",
                      focus,
                    ]}
                  >
                    {link.label}
                    <ExternalLink class="size-3.5" aria-hidden="true" />
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                ))}
            </div>
          </section>
        )
      }

      <p class="text-xs leading-relaxed text-muted-foreground">
        Questions about the decisions behind the code? <a
          href={`mailto:${siteConfig.email}?subject=${encodeURIComponent(`Let's discuss ${data.title}`)}`}
          class:list={[
            "rounded text-foreground underline underline-offset-4",
            focus,
          ]}>Ask me about this project.</a
        >
      </p>
    </aside>
  </div>

  <footer
    class="mt-12 flex flex-col items-start justify-between gap-6 border-t border-border pt-8 sm:flex-row sm:items-center"
  >
    <div>
      <h2 class="text-xl font-semibold tracking-tight">
        Looking for someone to build with?
      </h2><p
        class="mt-2 max-w-[52ch] text-sm leading-relaxed text-muted-foreground"
      >
        I’d be happy to talk through this project and how my experience could
        fit your team.
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <Button href={`mailto:${siteConfig.email}`} size="lg"
        >Get in touch <ArrowUpRight class="size-4" aria-hidden="true" /></Button
      ><Button
        href={`/resumes/${resume.currently_using}`}
        variant="outline"
        size="lg"
        download>Download resume</Button
      >
    </div>
  </footer>
</BaseLayout>
