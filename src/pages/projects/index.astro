---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";
import Rss from "@lucide/astro/icons/rss";
import { siteConfig } from "@/data/site";
import Button from "@/components/ui/Button.astro";
import MoveRight from "@lucide/astro/icons/move-right";
import MailIcon from "@lucide/astro/icons/mail";
import Badge from "@/components/ui/Badge.astro";
import FileDown from "@lucide/astro/icons/file-down";

import { frontmatter as resumeData } from "@/content/resumes.md";

const resumeUrl = `/resumes/${resumeData.currently_using}`;

const projects = await getCollection("projects");

// Prioritize the most important work (Featured first)
const featuredProjects = projects
  .filter((p) => p.data.featured)
  .sort(
    (a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0),
  );
const otherProjects = projects
  .filter((p) => !p.data.featured)
  .sort(
    (a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0),
  );

// Get unique tech stack for filtering
const allTech = [
  ...new Set(
    projects.flatMap((p) =>
      (p.data.stack || []).map((tech) => tech.split(":")[0].trim()),
    ),
  ),
];
---

<BaseLayout
  title="Projects"
  description="Full list of software projects and technical experiments."
>
  <Section class="mb-12 animate-reveal animation-delay-100">
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-6"
    >
      <div class="space-y-4">
        <h1 class="text-4xl font-extrabold tracking-tighter sm:text-5xl">
          Projects
        </h1>
        <p class="text-xl text-muted-foreground leading-relaxed max-w-2xl">
          A collection of systems, tools, and experiments.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <Badge variant="secondary" class="text-sm">
            {projects.length} Total Projects
          </Badge>
          <Badge variant="outline" class="text-sm">
            {featuredProjects.length} Featured
          </Badge>
          <Badge variant="outline" class="text-sm">
            {allTech.length} Technologies
          </Badge>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <Button
          href={`mailto:${siteConfig.email}?subject=Project%20Discussion`}
          size="lg"
        >
          <MailIcon class="size-4" />
          Discuss a Project
        </Button>
        <Button href="/rss.xml" variant="outline" size="lg">
          <Rss data-icon="inline-start" class="size-4" />RSS Feed
        </Button>
      </div>
    </div>
  </Section>

  {
    featuredProjects.length > 0 && (
      <Section
        title="Featured Work"
        class="mb-16 animate-reveal animation-delay-300 will-change-auto"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </Section>
    )
  }

  <Section
    title="All Projects"
    class="animate-reveal animation-delay-200 will-change-auto"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {otherProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>

  <Section
    class="mt-20 border-t border-border pt-12 text-center animate-reveal animation-delay-400"
  >
    <div class="max-w-2xl mx-auto space-y-6">
      <h2 class="text-2xl font-bold">Ready to build?</h2>
      <p class="text-muted-foreground text-lg">
        I specialize in improving existing codebases, reducing technical debt,
        and building maintainable applications with Laravel and React.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={`mailto:${siteConfig.email}`} size="lg">
          Let's Collaborate <MoveRight data-icon="inline-end" />
        </Button>
        <Button href={resumeUrl} variant="outline" size="lg" download>
          <FileDown data-icon="inline-start" />
          Download Resume
        </Button>
      </div>
      <p class="text-xs text-muted-foreground pt-4">
        I typically respond within 24 hours • Open to remote & full-time work
      </p>
    </div>
  </Section>
</BaseLayout>
