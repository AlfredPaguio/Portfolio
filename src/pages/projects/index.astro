---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";
import Rss from "@lucide/astro/icons/rss";
import { siteConfig } from "@/data/site";
import Button from "@/components/ui/Button.astro";
import MoveLeft from "@lucide/astro/icons/move-left";

const projects = await getCollection("projects");

// Prioritize the most important work (Featured first)
const featuredProjects = projects
  .filter((p) => p.data.featured)
  .sort(
    (a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0),
  );
const otherProjects = projects
  .filter((p) => !p.data.featured)
  .sort(
    (a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0),
  );
---

<BaseLayout
  title="Projects"
  description="Full list of software projects and technical experiments."
>
  <Section class="mb-12 animate-reveal animation-delay-100 will-change-auto">
    <header class="flex items-end justify-between">
      <div>
        <h1 class="text-4xl font-bold tracking-tight mb-2">Projects</h1>
        <p class="text-muted-foreground text-lg">
          A collection of systems, tools, and experiments.
        </p>
      </div>
      <a
        href="/rss.xml"
        class="flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors pb-1"
      >
        <Rss class="size-4" /> RSS Feed
      </a>
    </header>
  </Section>

  {
    featuredProjects.length > 0 && (
      <Section
        title="Featured Work(s)"
        class="mb-16 animate-reveal animation-delay-300 will-change-auto"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </Section>
    )
  }

  <Section title="All Projects" class="animate-reveal animation-delay-200 will-change-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {otherProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>

  <Section
    title="Ready to build?"
    class="mt-20 border-t border-border pt-12 text-center animate-reveal animation-delay-300 will-change-auto"
  >
    <p class="text-lg mb-6 text-neutral-500">
      Have a system that needs refactoring or a new feature logic?
    </p>
    <a
      href={`mailto:${siteConfig.email}`}
      class="text-3xl font-bold underline underline-offset-8 hover:text-primary transition-colors"
    >
      Let's collaborate &rarr;
    </a>
  </Section>
  <nav class="mt-4 flex justify-end-safe items-center-safe w-full">
    <Button
      href="/"
      variant="ghost"
      size="sm"
      class="-ml-3 text-muted-foreground hover:text-foreground"
    >
      <MoveLeft class="mr-2" /> Back to Home
    </Button>
  </nav>
</BaseLayout>
