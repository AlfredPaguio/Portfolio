---
import ProjectCard from "@/components/ProjectCard.astro";
import RecruiterCopy from "@/components/RecruiterCopy.astro";
import Button from "@/components/ui/Button.astro";
import { frontmatter as resumeData } from "@/content/resumes.md";
import { siteConfig } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import FileDown from "@lucide/astro/icons/file-down";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0),
);
const featured = projects.filter((project) => project.data.featured);
const others = projects.filter((project) => !project.data.featured);
const [lead, ...selected] = featured;
---

<BaseLayout
  title="Projects"
  description="Software projects by Alfred Paguio. Explore practical applications, developer tools, and the work behind them."
>
  <header
    class="mt-3 mb-9 flex flex-col items-start justify-between gap-5 sm:mb-12 sm:flex-row sm:gap-6"
  >
    <div>
      <h1
        class="mb-4 text-[clamp(36px,5vw,48px)] leading-[1.1] font-[750] tracking-[-0.045em]"
      >
        Projects
      </h1>
      <p
        class="max-w-[52ch] text-base leading-[1.65] text-pretty text-muted-foreground sm:text-[17px]"
      >
        Applications, tools, and experiments built with Laravel, React, and
        Python.
      </p>
    </div>
    <Button
      href={`/resumes/${resumeData.currently_using}`}
      variant="outline"
      size="lg"
      class="mt-1.25"
      download><FileDown aria-hidden="true" /> Download resume</Button
    >
  </header>

  <div class="mb-8 -mt-4">
    <RecruiterCopy compact />
  </div>

  {
    featured.length > 0 && (
      <section aria-labelledby="selected-heading" class="mt-12">
        <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <>
            <h2
              id="selected-heading"
              class="text-[21px] leading-[1.4] font-[650] tracking-[-0.025em]"
            >
              Featured projects{" "}
              <span class="ml-2 text-sm font-normal text-muted-foreground">
                {featured.length}
              </span>
            </h2>
            <p class="w-full text-[13px] text-muted-foreground sm:w-auto">
              A closer look at my work
            </p>
          </>
        </div>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6">
          {lead && (
            <div class="col-span-full">
              <ProjectCard project={lead} layout="spotlight" />
            </div>
          )}
          {selected.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section aria-labelledby="more-heading" class="mt-12">
        <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <>
            <h2
              id="more-heading"
              class="text-[21px] leading-[1.4] font-[650] tracking-[-0.025em]"
            >
              More projects{" "}
              <span class="ml-2 text-sm font-normal text-muted-foreground">
                {others.length}
              </span>
            </h2>
            <p class="w-full text-[13px] text-muted-foreground sm:w-auto">
              Company websites and business systems
            </p>
          </>
        </div>
        <div class="grid gap-4">
          {others.map((project) => (
            <ProjectCard project={project} layout="compact" />
          ))}
        </div>
      </section>
    )
  }

  <footer
    class="mt-12 flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center sm:gap-8"
  >
    <div>
      <h2 class="text-[22px] font-[650] tracking-[-0.025em] text-balance">
        Let’s talk about your next project.
      </h2><p
        class="mt-2 max-w-[54ch] text-sm leading-[1.7] text-muted-foreground"
      >
        I work mainly with Laravel and React, with a focus on application logic
        and improving existing systems.
      </p>
    </div>
    <Button href={`mailto:${siteConfig.email}`} size="lg"
      >Get in touch <ArrowUpRight aria-hidden="true" /></Button
    >
  </footer>
  <a
    class="mt-7 inline-block py-2 text-xs text-muted-foreground underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-4"
    href="/rss.xml">Subscribe to project updates via RSS</a
  >
</BaseLayout>
