---
import TechPill from "@/components/TechPill.astro";
const skills = [
  {
    id: "laravel",
    focus: "Application logic",
    href: "/projects/project-management-app/",
  },
  {
    id: "react",
    focus: "Interactive interfaces",
    href: "/projects/simple-astro-content-editor/",
  },
  {
    id: "typescript",
    focus: "Typed web applications",
    href: "/projects/simple-astro-content-editor/",
  },
  {
    id: "python",
    focus: "Scraping & data tools",
    href: "/projects/ecommerce-web-scraper/",
  },
];
---

<section
  id="skills"
  aria-labelledby="skills-heading"
  class="min-w-0 scroll-mt-28 rounded-xl border border-border bg-card p-6"
>
  <h2 id="skills-heading" class="text-lg font-semibold tracking-tight">
    My core toolkit
  </h2>
  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
    Explore how I’ve used each technology.
  </p>
  <div class="mt-4 grid grid-cols-1 gap-x-5 gap-y-4 min-[400px]:grid-cols-2">
    {
      skills.map((skill) => (
        <div>
          <>
            <TechPill id={skill.id} showVersion={false} class="font-medium" />
            <a
              href={skill.href}
              class="mt-1 flex min-h-9 items-center rounded text-xs text-muted-foreground underline underline-offset-4 hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-4"
            >
              {skill.focus}
            </a>
          </>
        </div>
      ))
    }
  </div>
</section>
