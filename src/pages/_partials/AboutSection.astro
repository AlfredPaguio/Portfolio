---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Button from "@/components/ui/Button.astro";
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="min-w-0 scroll-mt-28 p-6 sm:p-8">
  <h2 id="about-heading" class="text-lg font-semibold tracking-tight">
    A little about how I work
  </h2>
  <p class="mt-3 text-sm leading-7 text-muted-foreground">
    I built the Simple Astro Content Editor to make website content easier to
    update. It reads the rules for each type of content and creates an editable
    form with a live Markdown preview, reducing the need to edit configuration
    fields by hand.
  </p>
  <Button
    href="/projects/simple-astro-content-editor/"
    variant="link"
    class="mt-4 h-auto min-h-10 px-0 text-foreground underline decoration-border hover:text-foreground hover:decoration-foreground"
    >View Simple Astro Content Editor <ArrowRight
      class="size-4"
      aria-hidden="true"
    /></Button>
  <blockquote
    class="mt-4 border-t border-border pt-4 text-sm leading-relaxed text-muted-foreground">
    “Make it work. Make it right. Make it fast.”
    <cite class="mt-2 block text-xs not-italic">
      <a
        href="https://wiki.c2.com/?MakeItWorkMakeItRightMakeItFast"
        class="rounded underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-4 hover:text-accent"
        >Quote source</a
      ></cite
    >
  </blockquote>
</section>
