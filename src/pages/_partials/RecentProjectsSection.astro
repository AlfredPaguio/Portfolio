---
import { getCollection } from "astro:content";

import ProjectCard from "@/components/ProjectCard.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Section from "@/components/Section.astro";
import Button from "@/components/ui/Button.astro";

const allProjects = await getCollection("projects");
const recentProjects = allProjects
  // .filter((p) => p.data.featured)
  .sort((a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0))
  .slice(0, 4);
---

<!-- Recent Projects -->
<Section
  title="Recent projects"
  id="recent"
  class="animate-reveal animation-delay-600"
>
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-4 lg:gap-6 auto-rows-fr"
  >
    {
      recentProjects.map((project, index) => {
        const isLarge = index === 0 || index === 3;

        return (
          <div
            class:list={[
              "flex flex-col h-full",
              isLarge ? "lg:col-span-7" : "lg:col-span-5",
              // On tablet, make the first one take full width for impact
              index === 0 && "md:col-span-2 lg:col-span-7",
            ]}
          >
            <ProjectCard project={project} />
          </div>
        );
      })
    }
  </div>
  <div class="mt-12 flex justify-center animate-reveal animation-delay-700">
    <Button
      href="/projects/"
      size="lg"
      variant="outline"
      class="group w-full md:w-auto border-border/50 hover:border-accent/50 transition-all shadow-sm"
      aria-label="View all projects in archive"
    >
      View All Projects ({allProjects.length} Total)
      <ArrowRight
        data-icon="inline-end"
        class="group-hover:translate-x-1 transition-transform"
      />
    </Button>
  </div>
</Section>
