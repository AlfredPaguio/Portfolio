---
import ProjectCard from "@/components/ProjectCard.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { getCollection } from "astro:content";
const allProjects = await getCollection("projects");
const recentProjects = allProjects
  .sort((a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0))
  .slice(0, 4);
---

<section
  id="recent"
  aria-labelledby="recent-heading"
  class="scroll-mt-28 py-10 sm:py-12"
>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="recent-heading" class="text-2xl font-semibold tracking-tight">
        Recent projects
      </h2><p class="mt-2 text-sm text-muted-foreground">
        What I’ve built, why I built it, and how it works.
      </p>
    </div>
    <a
      href="/projects/"
      class="inline-flex min-h-10 items-center gap-2 rounded text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-4"
      >View all {allProjects.length} projects <ArrowRight
        class="size-4"
        aria-hidden="true"
      /></a
    >
  </div>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    {recentProjects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
