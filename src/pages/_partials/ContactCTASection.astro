---
import Button from "@/components/ui/Button.astro";
import RecruiterCopy from "@/components/RecruiterCopy.astro";
import { Content as LinkedInIcon } from "@/content/icons/linkedin.mdx";
import { Content as GithubIcon } from "@/content/techs/github.mdx";
import { siteConfig } from "@/data/site";
import Mail from "@lucide/astro/icons/mail";
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="scroll-mt-28 rounded-xl border border-border bg-card p-6 sm:p-8"
>
  <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
    <div>
      <p
        class="mb-2 inline-flex items-center gap-2 text-sm text-muted-foreground"
      >
        <span
          class="size-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400"
          aria-hidden="true"></span>Open to new opportunities
      </p><h2
        id="contact-heading"
        class="text-2xl font-semibold tracking-tight"
      >
        Let’s work together.
      </h2><p
        class="mt-3 max-w-[55ch] text-sm leading-relaxed text-muted-foreground"
      >
        Have a role or a project in mind? Send me the details. I’d be happy to
        discuss how I could contribute.
      </p>
    </div>
    <Button href={`mailto:${siteConfig.email}`} size="lg" class="w-fit"
      ><Mail aria-hidden="true" />Email me</Button
    >
  </div>
  <div
    class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-4"
  >
    <a
      href={`mailto:${siteConfig.email}`}
      class="rounded text-sm text-muted-foreground underline underline-offset-4 wrap-anywhere focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-4"
      >{siteConfig.email}</a
    >
    <div class="flex gap-2">
      <Button
        href={siteConfig.links.socials.linkedin}
        variant="outline"
        size="lg"><LinkedInIcon aria-hidden="true" />LinkedIn</Button
      ><Button
        href={siteConfig.links.socials.github}
        aria-label="GitHub profile"
        variant="outline"
        size="lg"><GithubIcon aria-hidden="true" />GitHub</Button>
    </div>
  </div>
  <div class="mt-5 border-t border-border pt-4">
    <RecruiterCopy compact />
  </div>
</section>
