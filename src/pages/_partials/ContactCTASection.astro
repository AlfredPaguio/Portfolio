---
import Button from "@/components/ui/Button.astro";
import RecruiterCopy from "@/components/RecruiterCopy.astro";
import { Content as LinkedInIcon } from "@/content/icons/linkedin.mdx";
import { Content as GithubIcon } from "@/content/techs/github.mdx";
import { frontmatter as resumeData } from "@/content/resumes.md";
import { siteConfig } from "@/data/site";
import Mail from "@lucide/astro/icons/mail";
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="scroll-mt-28 border-y border-border py-8 sm:py-10"
>
  <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(15rem,0.8fr)] md:gap-12">
    <div class="max-w-[55ch]">
      <h2 id="contact-heading" class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Let’s work together.
      </h2><p
        class="mt-3 max-w-[55ch] text-sm leading-relaxed text-muted-foreground"
      >
        Have a role or a project in mind? Send me the details. I’d be happy to
        discuss how I could contribute.
      </p>
    </div>
    <div class="flex flex-col items-start gap-3 md:border-l md:border-border md:pl-8">
      {
        resumeData.availability && (
          <p class="inline-flex items-center gap-2 text-sm text-muted-foreground">
            <span
              class="size-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400"
              aria-hidden="true"
            />
            {resumeData.availability}
          </p>
        )
      }
      <Button href={`mailto:${siteConfig.email}`} size="lg" class="min-h-11 w-full md:w-fit">
        <Mail aria-hidden="true" />Email me
      </Button>
      <p class="text-sm text-muted-foreground wrap-anywhere">
        If your mail app doesn’t open, use this address: <span class="select-all text-foreground">{siteConfig.email}</span>
      </p>
      <nav aria-label="Other contact options" class="flex flex-wrap gap-2">
        <Button
          href={siteConfig.links.socials.linkedin}
          variant="outline"
          size="lg"
          class="min-h-10"><LinkedInIcon aria-hidden="true" />LinkedIn</Button
        ><Button
          href={siteConfig.links.socials.github}
          aria-label="GitHub profile"
          variant="outline"
          size="lg"
          class="min-h-10"><GithubIcon aria-hidden="true" />GitHub</Button>
      </nav>
    </div>
  </div>
  <div class="mt-8 border-t border-border pt-5">
    <RecruiterCopy />
  </div>
</section>
