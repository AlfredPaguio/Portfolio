---
import { frontmatter as resumeData } from "@/content/resumes.md";
import { Image } from "astro:assets";
import myImage from "@/assets/images/profile.png";

import FileDown from "@lucide/astro/icons/file-down";
import ClockIcon from "@lucide/astro/icons/clock";
import { siteConfig } from "@/data/site";
import Button from "@/components/ui/Button.astro";

import { Content as LinkedInIcon } from "@/content/icons/linkedin.mdx";
import { Content as GithubIcon } from "@/content/techs/github.mdx";
import Separator from "@/components/ui/Separator.astro";

const resumeUrl = `/resumes/${resumeData.currently_using}`;
---

<header
  class="flex flex-col-reverse md:flex-row gap-8 items-start justify-between mb-18"
>
  <div class="flex-1 space-y-6">
    <h1
      class="animate-reveal text-4xl font-extrabold tracking-tighter sm:text-5xl will-change-auto"
    >
      Alfred U. Paguio
    </h1>

    <p
      class="animate-reveal animation-delay-100 text-xl text-muted-foreground leading-relaxed will-change-auto"
    >
      Junior Software Developer focusing on
      <span class="text-foreground font-medium">application logic</span>
      and the <span class="text-foreground font-medium">refactoring</span> of systems.
      I build with Laravel and React.
    </p>

    <!-- Location & Timezone Card -->
    <div
      class="flex items-center gap-3 p-3 rounded-lg border border-border bg-card/50 animate-reveal animation-delay-150 w-fit"
    >
      <div class="flex items-center gap-2">
        <span class="text-lg" aria-hidden="true">🇵🇭</span>
        <span class="font-medium text-sm text-foreground" aria-label="Country"
          >Philippines</span
        >
      </div>

      <!-- <div class="w-px h-4 bg-border"></div> -->

      <Separator orientation="vertical" />

      <div class="flex items-center gap-2">
        <span class="text-lg" aria-hidden="true"><ClockIcon /></span>
        <time id="local-time" class="font-mono text-sm text-foreground"
          >00:00:00 AM</time
        >
        <span class="text-muted-foreground text-xs" aria-label="Time Zone"
          >(UTC+8)</span
        >
      </div>
    </div>

    <div
      class="flex flex-col sm:flex-row items-start sm:items-center gap-4 pt-4 animate-reveal animation-delay-200 will-change-auto"
    >
      <Button
        href={resumeUrl}
        size="lg"
        class="font-semibold"
        aria-label="Download my resume"
        download
      >
        <FileDown data-icon="inline-start" />
        Download My Resume
      </Button>

      <!-- Divider (desktop only) -->
      <Separator orientation="vertical" class="hidden sm:block" />

      <div class="flex items-center gap-2">
        <Button
          variant="outline"
          size="sm"
          href={siteConfig.links.socials.linkedin}
          class="text-muted-foreground hover:text-foreground"
          aria-label="LinkedIn Profile"
        >
          <LinkedInIcon data-icon="inline-start" />
          <span class="hidden sm:inline">LinkedIn</span>
        </Button>
        <Button
          variant="outline"
          size="sm"
          href={siteConfig.links.socials.github}
          class="text-muted-foreground hover:text-foreground"
          aria-label="Github Profile"
        >
          <GithubIcon data-icon="inline-start" />
          <span class="hidden sm:inline">GitHub</span>
        </Button>
      </div>
    </div>
  </div>

  <figure class="relative group animate-reveal animation-delay-100">
    <div
      class="absolute -inset-4 bg-linear-to-r from-primary/20 to-muted/20 rounded-3xl blur-xl opacity-50 group-hover:opacity-70 transition-opacity duration-700"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative size-48 md:size-56 rounded-2xl overflow-hidden border-2 border-border shadow-2xl"
    >
      <Image
        src={myImage}
        alt="Portrait of Alfred U. Paguio"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 motion-reduce:transform-none motion-reduce:transition-none"
        width={224}
        height={224}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </figure>
</header>

<script is:inline>
  // Live timezone clock for Philippines (Asia/Manila - UTC+8)
  function updateLocalTime() {
    /**  @type {HTMLTimeElement} */
    const timeElement = document.getElementById("local-time");
    if (!timeElement) return;

    const now = new Date();
    /**  @type {Intl.DateTimeFormatOptions} */
    const options = {
      timeZone: "Asia/Manila",
      hour: "2-digit",
      minute: "2-digit",
      // second: "2-digit",
      hour12: true,
    };

    const formatter = new Intl.DateTimeFormat("en-US", options);
    // https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/time#usage_notes
    timeElement.textContent = formatter.format(now);
    timeElement.dateTime = formatter.format(now);
  }

  // Update immediately and then every second
  updateLocalTime();
  setInterval(updateLocalTime, 60000);
</script>
