---
import myImage from "@/assets/images/profile.png";
import Button from "@/components/ui/Button.astro";
import { frontmatter as resumeData } from "@/content/resumes.md";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ClockIcon from "@lucide/astro/icons/clock";
import FileText from "@lucide/astro/icons/file-text";
import { Image } from "astro:assets";
---

<header
  class="grid items-start gap-8 pt-3 pb-8 md:grid-cols-[minmax(0,1fr)_288px] md:gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12">
  <div class="min-w-0">
    <p class="mb-3 text-sm font-medium text-muted-foreground">
      Junior Software Developer
    </p>
    <h1
      class="text-4xl leading-[1.12] font-extrabold tracking-tight text-balance sm:text-5xl">
      Alfred U. Paguio
    </h1>
    <p class="mt-5 max-w-[38ch] text-xl leading-relaxed text-pretty">
      I build practical web applications with Laravel and React, with a focus
      on backend systems and API integration.
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <span class="inline-flex items-center gap-2 font-medium">
        <span aria-hidden="true">🇵🇭</span>
        Philippines <span class="font-normal text-muted-foreground">UTC+8</span>
      </span>
      <span class="inline-flex items-center gap-2">
        <ClockIcon class="size-4 text-muted-foreground" aria-hidden="true" />
        <span class="sr-only">Current time in the Philippines: </span>
        <time id="local-time" class="font-mono tabular-nums">UTC+8</time>
        <span class="text-xs text-muted-foreground">local time</span>
      </span>
      {
        resumeData.availability && (
          <span class="inline-flex items-center gap-2 text-muted-foreground">
            <span class="size-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400" aria-hidden="true" />
            {resumeData.availability}
          </span>
        )
      }
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-2.5">
      <Button
        href={`/resumes/${resumeData.currently_using}`}
        size="lg"
        class="w-full sm:w-auto"
        ><FileText aria-hidden="true" />View resume</Button
      >
      <Button
        href="#featured"
        variant="outline"
        size="lg"
        >Explore projects <ArrowRight aria-hidden="true" /></Button
      >
    </div>
  </div>
  <figure class="mx-auto w-full max-w-80 md:mx-0 md:max-w-none">
    <Image
      src={myImage}
      alt="Portrait of Alfred U. Paguio"
      class="aspect-square w-full rounded-2xl border border-border bg-card object-cover"
      width={320}
      height={320}
      loading="eager"
      fetchpriority="high"
    />
  </figure>
</header>
<script>
  const time = document.querySelector<HTMLTimeElement>("#local-time");
  function updateTime() {
    if (!time) return;
    const now = new Date();
    time.textContent = new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Manila",
      hour: "numeric",
      minute: "2-digit",
      hour12: true,
    }).format(now);
    time.dateTime = now.toISOString();
    time.title = new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Manila",
      dateStyle: "full",
    }).format(now);
  }
  updateTime();
  setInterval(updateTime, 60_000);
</script>
