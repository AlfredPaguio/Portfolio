---
import myImage from "@/assets/images/profile.png";
import RecruiterCopy from "@/components/RecruiterCopy.astro";
import Button from "@/components/ui/Button.astro";
import { Content as LinkedInIcon } from "@/content/icons/linkedin.mdx";
import { frontmatter as resumeData } from "@/content/resumes.md";
import { Content as GithubIcon } from "@/content/techs/github.mdx";
import { siteConfig } from "@/data/site";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ClockIcon from "@lucide/astro/icons/clock";
import FileDown from "@lucide/astro/icons/file-down";
import { Image } from "astro:assets";
---

<header
  class="grid items-start gap-8 pt-3 pb-10 md:grid-cols-[minmax(0,1fr)_288px] md:gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12"
>
  <div class="min-w-0">
    <p class="mb-3 text-sm font-medium text-muted-foreground">
      Junior Software Developer
    </p>
    <h1
      class="text-4xl leading-[1.12] font-extrabold tracking-tight text-balance sm:text-5xl"
    >
      Alfred U. Paguio
    </h1>
    <p class="mt-5 max-w-[38ch] text-xl leading-relaxed text-pretty">
      I build with Laravel and React, with a focus on application logic and
      refactoring.
    </p>
    <p class="mt-3 max-w-[54ch] text-sm leading-relaxed text-muted-foreground">
      I enjoy turning practical problems into well-structured applications and
      improving the systems behind them.
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-2 text-sm font-medium"
          ><span aria-hidden="true">🇵🇭</span>Philippines</span
        ><span class="text-xs text-muted-foreground">UTC+8</span>
      </div>
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
        <ClockIcon
          class="size-4 text-muted-foreground"
          aria-hidden="true"
        /><time
          id="local-time"
          class="font-mono tabular-nums"
          aria-label="Current time in Manila">Manila time</time
        ><span id="local-day-period" class="text-xs text-muted-foreground"
          >My local time</span
        >
      </div>
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-2.5">
      <Button
        href={`/resumes/${resumeData.currently_using}`}
        size="lg"
        class="w-full sm:w-auto"
        download><FileDown aria-hidden="true" />Download resume</Button
      >
      <Button
        href={siteConfig.links.socials.linkedin}
        variant="outline"
        size="lg"><LinkedInIcon aria-hidden="true" />LinkedIn</Button
      >
      <Button
        href={siteConfig.links.socials.github}
        aria-label="GitHub profile"
        variant="outline"
        size="lg"><GithubIcon aria-hidden="true" />GitHub</Button
      >
    </div>
    <div class="mt-5 border-t border-border pt-4">
      <RecruiterCopy compact />
    </div>
    <a
      href="#recent"
      class="mt-5 inline-flex min-h-10 items-center gap-2 rounded text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-4"
      >Explore my projects <ArrowRight class="size-4" aria-hidden="true" /></a
    >
  </div>
  <figure class="mx-auto w-full max-w-80 md:mx-0 md:max-w-none">
    <Image
      src={myImage}
      alt="Portrait of Alfred U. Paguio"
      class="aspect-square w-full rounded-2xl border border-border bg-card object-cover"
      width={320}
      height={320}
      loading="eager"
      fetchpriority="high"
    />
  </figure>
</header>
<script>
  const time = document.querySelector<HTMLTimeElement>("#local-time");
  const label = document.querySelector("#local-day-period");
  function updateTime() {
    if (!time) return;
    const now = new Date();
    time.textContent = new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Manila",
      hour: "numeric",
      minute: "2-digit",
      hour12: true,
    }).format(now);
    time.dateTime = now.toISOString();
    time.title = new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Manila",
      dateStyle: "full",
    }).format(now);
    const hour = Number(
      new Intl.DateTimeFormat("en-US", {
        timeZone: "Asia/Manila",
        hour: "numeric",
        hourCycle: "h23",
      }).format(now),
    );
    if (label)
      label.textContent =
        hour >= 22 || hour < 7 ? "Nighttime here" : "My local time";
  }
  updateTime();
  setInterval(updateTime, 60_000);
</script>
