---
import Button from "@/components/ui/Button.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404: Page Not Found">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <p
      class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-4"
    >
      Error 404
    </p>
    <h1 class="text-4xl font-extrabold tracking-tighter mb-6">
      Page Not Found
    </h1>
    <p class="text-muted-foreground max-w-md mb-10 leading-relaxed">
      The path you are looking for does not exist or has been refactored to a
      new location.
    </p>
    <Button
      href="/"
      class="px-6 py-3 bg-primary text-primary-foreground font-bold rounded-xl hover:opacity-90 transition-opacity"
    >
      Return to Home
    </Button>
  </div>
</BaseLayout>
