---
// import { fetchLatestResumes } from "@/data/Resumes";
import Section from "@/components/Section.astro";
import TechPill from "@/components/TechPill.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { frontmatter as resumeData } from "@/content/resumes.md";

import { getCollection } from "astro:content";
import Button from "@/components/ui/Button.astro";
const projects = await getCollection("projects");

const techs = await getCollection("techs");

// console.log("Project Count: ", projects.length);

if (!projects) return null;

// let webDevResume;
// let softwareEngResume;
// try {
//   const resumes = await fetchLatestResumes();
//   webDevResume =
//     resumes.find((a) => a.name.includes("WebDev"))?.browser_download_url || "#";
//   softwareEngResume =
//     resumes.find((a) => a.name.includes("SoftwareEngineer"))
//       ?.browser_download_url || "#";
// } catch (error) {
//   webDevResume = null;
//   softwareEngResume = null;
