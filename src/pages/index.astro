---
import Section from "@/components/Section.astro";
import TechPill from "@/components/TechPill.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { frontmatter as resumeData } from "@/content/resumes.md";
import { Image } from "astro:assets";
import myImage from "@/assets/images/profile.png";

import { getCollection } from "astro:content";
import Button from "@/components/ui/Button.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import FileDown from "@lucide/astro/icons/file-down";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { Content as LinkedInIcon } from "@/content/icons/linkedin.mdx";
import { Content as GithubIcon } from "@/content/techs/github.mdx";

import { siteConfig } from "@/data/site";
import Hand from "@lucide/astro/icons/hand";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);

const coreStack = [
  { id: "laravel", years: "1 Year" },
  { id: "react", years: "1 Year" },
  { id: "typescript", years: "1 Year" },
];
---

<BaseLayout openGraphType="portfolio">
  <!-- <a href={webDevResume}>Web Dev</a>
  <a href={softwareEngResume}>Web Dev</a> -->
  <!-- will use static to avoid github rate limit -->
  <header
    class="flex flex-col-reverse md:flex-row gap-8 items-start justify-between mb-18"
  >
    <div class="flex-1 space-y-6">
      <h1
        class="animate-reveal text-4xl font-extrabold tracking-tighter sm:text-5xl"
      >
        Alfred U. Paguio
      </h1>
      <p
        class="animate-reveal animation-delay-100 text-xl text-muted-foreground leading-relaxed"
      >
        Junior Software Developer focusing on <span
          class="text-foreground font-medium">application logic</span
        > and the <span class="text-foreground font-medium">refactoring</span> of
        systems. I build with Laravel and React.
      </p>

      <div class="flex flex-wrap gap-4 pt-4 animate-reveal animation-delay-200">
        <Button
          href={resumeData.software_engineer || "#"}
          size="lg"
          class="font-semibold"
          aria-label="Download Software Engineer Resume"
        >
          Software Engineer Resume
          <FileDown slot="right-icon" />
        </Button>
        <Button
          href={resumeData.webdev || "#"}
          size="lg"
          variant={"outline"}
          aria-label="Download Web Developer Resume"
        >
          Web Developer Resume
          <FileDown slot="right-icon" />
        </Button>
      </div>

      <div class="flex items-center gap-4 animate-reveal animation-delay-300">
        <Button
          variant="ghost"
          size="sm"
          href={siteConfig.links.socials.linkedin}
        >
          <LinkedInIcon /> LinkedIn
        </Button>
        <Button
          variant="ghost"
          size="sm"
          href={siteConfig.links.socials.github}
        >
          <GithubIcon /> Github
        </Button>
      </div>
    </div>
    <div class="relative group animate-reveal animation-delay-100">
      <div
        class="absolute -inset-4 bg-linear-to-r from-primary/20 to-muted/20 rounded-3xl blur-xl opacity-50 group-hover:opacity-70 transition-opacity duration-700"
      >
      </div>
      <div
        class="relative size-48 md:size-56 rounded-2xl overflow-hidden border-2 border-border shadow-2xl"
      >
        <Image
          src={myImage}
          alt="Portrait of Alfred U. Paguio"
          class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          width={224}
          height={224}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <!-- TODO: on frontmatter data -->
      <!-- <div class="absolute -bottom-3 -right-3 bg-primary text-primary-foreground text-xs font-bold px-3 py-1 rounded-full border border-border shadow-lg">
        Open to Work
      </div> -->
    </div>
  </header>

  <Section
    title="About me"
    id="about"
    class="animate-reveal animation-delay-400"
  >
    <p class="text-muted-foreground leading-relaxed">
      I specialize in building and maintaining well-structured applications,
      with a strong focus on clean architecture and long-term maintainability. I
      work mainly with Laravel and React, and I enjoy improving existing systems
      through refactoring and thoughtful application design.
    </p>
  </Section>

  <Section
    title="Expertise"
    id="skills"
    class="animate-reveal animation-delay-500"
  >
    <div class="flex flex-col gap-2">
      {
        coreStack.map((skill) => (
          <div class="flex items-center justify-between p-4 rounded-xl border border-border bg-card">
            <TechPill
              id={skill.id}
              class="rounded-none border-0 border-transparent bg-transparent"
            />
            <span class="text-xs font-mono text-muted-foreground">
              {skill.years}
            </span>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Featured Projects -->
  <Section
    title="Featured projects"
    id="featured"
    class="animate-reveal animation-delay-600"
  >
    <div class="grid gap-4 sm:grid-cols-2">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <div class="mt-8 text-center">
      <Button
        href="/projects/"
        variant="outline"
        class="w-full md:w-auto justify-center"
        aria-label="View all projects in archive"
      >
        View All Projects ({allProjects.length} Total)
        <ArrowRight slot="right-icon" />
      </Button>
    </div>
  </Section>

  <!-- Contact Section -->
  <Section
    title="Get in Touch"
    id="contact"
    class="animate-reveal animation-delay-700"
  >
    <div class="rounded-lg border border-border bg-muted/30 p-6 sm:p-8">
      <p class="text-muted-foreground leading-relaxed">
        I'm currently open to new opportunities. Whether you have a question or
        just want to say hi, feel free to reach out and I'll get back to you as
        soon as possible.
      </p>

      <div class="flex items-center gap-4">
        <a
          href={`mailto:${siteConfig.email}`}
          class="mt-6 inline-flex items-center justify-center rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 has-[>svg]:px-3"
        >
          Say Hello
          <Hand slot="right-icon" />
        </a>

        <Button
          variant="ghost"
          size="sm"
          class="mt-6"
          href={siteConfig.links.socials.linkedin}
        >
          <LinkedInIcon /> LinkedIn
        </Button>
        <Button
          variant="ghost"
          size="sm"
          class="mt-6"
          href={siteConfig.links.socials.github}
        >
          <GithubIcon /> Github
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
