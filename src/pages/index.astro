---

<BaseLayout>
  <!-- <a href={webDevResume}>Web Dev</a>
  <a href={softwareEngResume}>Web Dev</a> -->
  <!-- will use static to avoid github rate limit -->
  <header class="space-y-6">
    <h1 class="text-4xl font-extrabold tracking-tighter sm:text-5xl">
      Alfred U. Paguio
    </h1>
    <p class="text-xl text-muted-foreground leading-relaxed">
      Junior Software Developer focusing on <span
        class="text-foreground font-medium">application logic</span
      > and the <span class="text-foreground font-medium">refactoring</span> of systems.
      I build with Laravel and React.
    </p>

    <div class="flex flex-wrap gap-4 pt-4">
      <Button href={resumeData.software_engineer || "#"}>
        Software Engineer CV
      </Button>
      <Button href={resumeData.webdev || "#"} variant={"outline"}>
        Web Developer CV
      </Button>
    </div>
  </header>
  <Section title="test" id="skills">
    {
      techs.map((tech) => (
        <TechPill id={tech.data.name.replaceAll(" ", "").toLowerCase()} />
      ))
    }
  </Section>

  <Section title="Expertise" id="skills">
    <div class="flex flex-wrap gap-2">
      <TechPill id="astro" />
      <TechPill id="github" />
      <TechPill id="laravel" />
      <TechPill id="react" />
      <TechPill id="typescript" />
      <TechPill id="tailwindcss" />
      <TechPill id="postgresql" />
    </div>
  </Section>

  <ul>
    {
      projects.map((project) => (
        <li>
          <a href={`/projects/${project.id}/`}>{project.data.title}</a>
          {project.data.stack.map((tech) => (
            <div class="inline-flex gap-2">
              {/* <span>{tech}</span> */}
              <TechPill id={tech.replaceAll(" ", "").toLowerCase()} />
            </div>
          ))}
        </li>
      ))
    }
  </ul>
</BaseLayout>
