---
import Section from "@/components/Section.astro";
import TechPill from "@/components/TechPill.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { frontmatter as resumeData } from "@/content/resumes.md";
import { Image } from "astro:assets";
import myImage from "@/assets/images/profile.png";

import { getCollection } from "astro:content";
import Button from "@/components/ui/Button.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import FileDown from "@lucide/astro/icons/file-down";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { Content as LinkedInIcon } from "@/content/icons/linkedin.mdx";
import { Content as GithubIcon } from "@/content/techs/github.mdx";

import { siteConfig } from "@/data/site";
import MailPlusIcon from "@lucide/astro/icons/mail-plus";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import Badge from "@/components/ui/Badge.astro";
import Hero from "@/pages/_partials/Hero.astro";

const allProjects = await getCollection("projects");
const recentProjects = allProjects
  // .filter((p) => p.data.featured)
  .sort((a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0))
  .slice(0, 4);

const coreStack = [
  { id: "laravel", years: "1 Year" },
  { id: "react", years: "1 Year" },
  { id: "typescript", years: "1 Year" },
];
---

<BaseLayout openGraphType="portfolio">
  <!-- <a href={webDevResume}>Web Dev</a>
  <a href={softwareEngResume}>Web Dev</a> -->
  <!-- will use static to avoid github rate limit -->

  <Hero />
  <Section
    title="About me"
    id="about"
    class="animate-reveal animation-delay-400"
  >
    <Card size="sm">
      <CardContent class="space-y-3">
        <p class="text-lg leading-relaxed text-foreground/90">
          I'm a full-stack developer who enjoys building, refactoring, and
          maintaining well-structured applications. I work mainly with Laravel
          and React, focusing on improving existing systems through thoughtful
          design and clean architecture.
        </p>

        <div class="flex items-center gap-2 pt-2 border-t border-border/60">
          <span class="text-base font-mono text-muted-foreground italic">
            "Make it work. Make it right. Make it fast."
          </span>
          <cite>
            <a
              href="https://wiki.c2.com/?MakeItWorkMakeItRightMakeItFast"
              target="_blank"
              rel="noopener noreferrer"
              title="Make It Work, Make It Right, Make It Fast"
              class="text-xs text-muted-foreground hover:text-foreground transition-colors"
            >
              source ↗
            </a>
          </cite>
        </div>
      </CardContent>
    </Card>
  </Section>
  <Section
    title="Current tech stack"
    id="skills"
    class="animate-reveal animation-delay-400"
  >
    <Card
      size="sm"
      class="animate-reveal animation-delay-500 relative py-8 lg:py-12"
    >
      <CardHeader>
        <CardDescription class="text-base">
          Technologies I work with regularly
        </CardDescription>
      </CardHeader>

      <CardContent>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {
            coreStack.map((skill) => (
              <div class="flex items-center justify-between p-3 rounded-lg border border-border bg-muted/30 hover:bg-muted/50 transition-colors">
                <TechPill id={skill.id} class="border-0 bg-transparent px-0" />
                <Badge variant="secondary" class="font-mono text-[10px]">
                  {skill.years}
                </Badge>
              </div>
            ))
          }
        </div>
      </CardContent>
    </Card>
  </Section>

  <!-- Recent Projects -->
  <Section
    title="Recent projects"
    id="recent"
    class="animate-reveal animation-delay-600"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-4 lg:gap-6 auto-rows-fr"
    >
      {
        recentProjects.map((project, index) => {
          const isLarge = index === 0 || index === 3;

          return (
            <div
              class:list={[
                "flex flex-col h-full",
                isLarge ? "lg:col-span-7" : "lg:col-span-5",
                // On tablet, make the first one take full width for impact
                index === 0 && "md:col-span-2 lg:col-span-7",
              ]}
            >
              <ProjectCard project={project} />
            </div>
          );
        })
      }
    </div>
    <div class="mt-12 flex justify-center animate-reveal animation-delay-700">
      <Button
        href="/projects/"
        size="lg"
        variant="outline"
        class="group w-full md:w-auto border-border/50 hover:border-accent/50 transition-all shadow-sm"
        aria-label="View all projects in archive"
      >
        View All Projects ({allProjects.length} Total)
        <ArrowRight
          data-icon="inline-end"
          class="group-hover:translate-x-1 transition-transform"
        />
      </Button>
    </div>
  </Section>

  <Section
    title="Let's work together"
    id="contact"
    class="animate-reveal animation-delay-700"
  >
    <Card class="border-primary/20 bg-linear-to-br from-card to-muted/10">
      <CardHeader class="pb-2">
        <CardTitle class="text-lg">Open to new opportunities</CardTitle>
        <CardDescription>
          Available for full-time roles, contract work, or freelance projects
        </CardDescription>
      </CardHeader>

      <CardContent class="space-y-6">
        <!-- Primary CTA -->
        <div class="flex flex-wrap items-center gap-3">
          <Button
            href={`mailto:${siteConfig.email}`}
            size="lg"
            class="font-semibold"
          >
            <MailPlusIcon data-icon="inline-start" />
            Email Me Directly
          </Button>

          <span class="text-sm text-muted-foreground"> or connect via: </span>

          <div class="flex items-center gap-1">
            <Button
              variant="outline"
              size="sm"
              href={siteConfig.links.socials.linkedin}
              class="gap-1"
            >
              <LinkedInIcon class="size-4" data-icon="inline-start" /> LinkedIn
            </Button>
            <Button
              variant="outline"
              size="sm"
              href={siteConfig.links.socials.github}
              class="gap-1"
            >
              <GithubIcon class="size-4" data-icon="inline-start" /> GitHub
            </Button>
          </div>
        </div>

        <p class="text-xs text-muted-foreground pt-2 border-t border-border">
          I typically respond within 24 hours. Feel free to reach out with your
          project details, role description, or just to say hi.
        </p>
      </CardContent>
    </Card>
  </Section>
</BaseLayout>
